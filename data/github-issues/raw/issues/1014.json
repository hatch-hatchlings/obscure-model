.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"id": 3148661299, "node_id": "MDEyOkxhYmVsZWRFdmVudDMxNDg2NjEyOTk=", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/3148661299", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "event": "labeled", "commit_id": null, "commit_url": null, "created_at": "2020-03-20T09:55:58Z", "label": {"name": "question", "color": "cc317c"}, "intent": null, "performed_via_github_app": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/602038932", "html_url": "https://github.com/mavlink/MAVSDK/issues/1014#issuecomment-602038932", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1014", "id": 602038932, "node_id": "MDEyOklzc3VlQ29tbWVudDYwMjAzODkzMg==", "user": {"login": "eng-86", "id": 62407695, "node_id": "MDQ6VXNlcjYyNDA3Njk1", "avatar_url": "https://avatars.githubusercontent.com/u/62407695?v=4", "gravatar_id": "", "url": "https://api.github.com/users/eng-86", "html_url": "https://github.com/eng-86", "followers_url": "https://api.github.com/users/eng-86/followers", "following_url": "https://api.github.com/users/eng-86/following{/other_user}", "gists_url": "https://api.github.com/users/eng-86/gists{/gist_id}", "starred_url": "https://api.github.com/users/eng-86/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/eng-86/subscriptions", "organizations_url": "https://api.github.com/users/eng-86/orgs", "repos_url": "https://api.github.com/users/eng-86/repos", "events_url": "https://api.github.com/users/eng-86/events{/privacy}", "received_events_url": "https://api.github.com/users/eng-86/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2020-03-21T12:43:00Z", "updated_at": "2020-03-21T17:32:48Z", "body": "Hello again, this is my working code for reading the position of multiple drones from a leader drone synchronously. I tried this code using multiple drones SITL with GAZEBO and QGC and was able to read info of 4 iris vehicles it worked great. \r\n\r\n```\r\n//\r\n// Example access telemetry of multiple vehicles.\r\n//./telemetry udp://:14540 udp://:14541 ....\r\n//\r\n// Author: H. Mazeh\r\n// Author: 17/03/2020\r\n\r\n#include <mavsdk/mavsdk.h>\r\n#include <mavsdk/plugins/telemetry/telemetry.h>\r\n\r\n#include <cstdint>\r\n#include <iostream>\r\n#include <thread>\r\n#include <chrono>\r\n#include <functional>\r\n#include <future>\r\n#include <memory>\r\n#include <string>\r\n#include <ctime>\r\n#include <fstream>\r\n\r\nusing namespace mavsdk;\r\nusing namespace std::chrono;\r\nusing namespace std::this_thread;\r\n\r\n#define ERROR_CONSOLE_TEXT \"\\033[31m\" // Turn text on console red\r\n#define TELEMETRY_CONSOLE_TEXT \"\\033[34m\" // Turn text on console blue\r\n#define NORMAL_CONSOLE_TEXT \"\\033[0m\" // Restore normal console colour\r\n\r\nint main(int argc, char** argv)\r\n{\r\n    Mavsdk dc;\r\n\r\n    int total_udp_ports = argc - 1;\r\n\r\n    // the loop below adds the number of ports the sdk monitors.\r\n    for (int i = 1; i < argc; ++i) {\r\n        ConnectionResult connection_result = dc.add_any_connection(argv[i]);\r\n        if (connection_result != ConnectionResult::SUCCESS) {\r\n            std::cerr << ERROR_CONSOLE_TEXT\r\n                      << \"Connection error: \" << connection_result_str(connection_result)\r\n                      << NORMAL_CONSOLE_TEXT << std::endl;\r\n            return 1;\r\n        }\r\n    }\r\n\r\n    std::atomic<signed> num_systems_discovered{0};\r\n\r\n    std::cout << \"Waiting to discover system...\" << std::endl;\r\n    dc.register_on_discover([&num_systems_discovered](uint64_t uuid) {\r\n        std::cout << \"Discovered system with UUID: \" << uuid << std::endl;\r\n        ++num_systems_discovered;\r\n    });\r\n\r\n    // We usually receive heartbeats at 1Hz, therefore we should find a system after around 2\r\n    // seconds.\r\n    sleep_for(seconds(2));\r\n\r\n    if (num_systems_discovered != total_udp_ports) {\r\n        std::cerr << ERROR_CONSOLE_TEXT << \"Not all systems found, exiting.\" << NORMAL_CONSOLE_TEXT\r\n                  << std::endl;\r\n        return 1;\r\n    }\r\n\r\n    std::vector<uint64_t> system_vector = dc.system_uuids();\r\n    std::shared_ptr<Telemetry> telemetry[system_vector.size()];\r\n\r\n    for (unsigned i=0; i<system_vector.size(); i++){\r\n        telemetry[i] = std::make_shared<Telemetry>(dc.system(system_vector[i]));\r\n\r\n        // Set position update rate to 1 Hz.\r\n        const Telemetry::Result set_rate_result1 = telemetry[i]->set_rate_position(1);\r\n        if (set_rate_result1 != Telemetry::Result::SUCCESS) {\r\n            // handle rate-setting failure (in this case print error)\r\n            std::cout << \"Setting rate failed telemetry:\"<< i+1 << \" \" << Telemetry::result_str(set_rate_result1) << std::endl;\r\n        }\r\n    }\r\n\r\n    Telemetry::Position position1[system_vector.size()];        \r\n    //Telemetry::PositionBody position2[system_vector.size()];\r\n\r\n    while(1) {\r\n        for (unsigned i=0; i<system_vector.size(); i++){\r\n            position1[i] = telemetry[i]->position();\r\n            std::cout << \"Altitude\" << i+1 <<  \" \" << position1[i].relative_altitude_m << \" m\" << std::endl\r\n                      << \"Latitude\" << i+1 <<  \" \" << position1[i].latitude_deg << std::endl\r\n                      << \"Longitude\" << i+1 <<  \" \" << position1[i].longitude_deg << std::endl;\r\n        }\r\n\r\n        /*for (unsigned i=0; i<system_vector.size(); i++){\r\n            position2[i] = telemetry[i]->position();\r\n            std::cout << \"x\" << i+1 <<  \" \" << position2[i].x_m << std::endl\r\n                      << \"y\" << i+1 <<  \" \" << position2[i].y_m << std::endl\r\n                      << \"z\" << i+1 <<  \" \" << position2[i].z_m << std::endl;\r\n        }*/\r\n        sleep_for(seconds(1));\r\n    }\r\n\r\n    return(0);\r\n}\r\n```\r\nMy future purpose research  is to implement PSO, GA... online algorithms for path planning of cooperative UAVs, and i need to access the body frame position values. I could not access it since I did not found functions for telemetry position body update and telemetry position body data request as for position we have set_rate_position() and position().\r\nthanks for help", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/602038932/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "eng-86", "id": 62407695, "node_id": "MDQ6VXNlcjYyNDA3Njk1", "avatar_url": "https://avatars.githubusercontent.com/u/62407695?v=4", "gravatar_id": "", "url": "https://api.github.com/users/eng-86", "html_url": "https://github.com/eng-86", "followers_url": "https://api.github.com/users/eng-86/followers", "following_url": "https://api.github.com/users/eng-86/following{/other_user}", "gists_url": "https://api.github.com/users/eng-86/gists{/gist_id}", "starred_url": "https://api.github.com/users/eng-86/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/eng-86/subscriptions", "organizations_url": "https://api.github.com/users/eng-86/orgs", "repos_url": "https://api.github.com/users/eng-86/repos", "events_url": "https://api.github.com/users/eng-86/events{/privacy}", "received_events_url": "https://api.github.com/users/eng-86/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/602039389", "html_url": "https://github.com/mavlink/MAVSDK/issues/1014#issuecomment-602039389", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1014", "id": 602039389, "node_id": "MDEyOklzc3VlQ29tbWVudDYwMjAzOTM4OQ==", "user": {"login": "eng-86", "id": 62407695, "node_id": "MDQ6VXNlcjYyNDA3Njk1", "avatar_url": "https://avatars.githubusercontent.com/u/62407695?v=4", "gravatar_id": "", "url": "https://api.github.com/users/eng-86", "html_url": "https://github.com/eng-86", "followers_url": "https://api.github.com/users/eng-86/followers", "following_url": "https://api.github.com/users/eng-86/following{/other_user}", "gists_url": "https://api.github.com/users/eng-86/gists{/gist_id}", "starred_url": "https://api.git