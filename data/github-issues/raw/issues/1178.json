s/mavlink/MAVSDK/contributors", "subscribers_url": "https://api.github.com/repos/mavlink/MAVSDK/subscribers", "subscription_url": "https://api.github.com/repos/mavlink/MAVSDK/subscription", "commits_url": "https://api.github.com/repos/mavlink/MAVSDK/commits{/sha}", "git_commits_url": "https://api.github.com/repos/mavlink/MAVSDK/git/commits{/sha}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/comments{/number}", "issue_comment_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments{/number}", "contents_url": "https://api.github.com/repos/mavlink/MAVSDK/contents/{+path}", "compare_url": "https://api.github.com/repos/mavlink/MAVSDK/compare/{base}...{head}", "merges_url": "https://api.github.com/repos/mavlink/MAVSDK/merges", "archive_url": "https://api.github.com/repos/mavlink/MAVSDK/{archive_format}{/ref}", "downloads_url": "https://api.github.com/repos/mavlink/MAVSDK/downloads", "issues_url": "https://api.github.com/repos/mavlink/MAVSDK/issues{/number}", "pulls_url": "https://api.github.com/repos/mavlink/MAVSDK/pulls{/number}", "milestones_url": "https://api.github.com/repos/mavlink/MAVSDK/milestones{/number}", "notifications_url": "https://api.github.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/1177", "html_url": "https://github.com/mavlink/MAVSDK/pull/1177", "diff_url": "https://github.com/mavlink/MAVSDK/pull/1177.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/1177.patch", "merged_at": "2020-08-27T14:28:44Z"}, "body": "Until this PR, a UDP remote is identified by an `<ip, port, sysid>`. This means that if two systems exist on the same `UDPConnection` (which typically happens when you have an onboard component connecting to both the FCU and a ground station), two remotes will be created. As a consequence, broadcast messages (such as `HEARTBEAT` or `TIMESYNC`) will be sent twice on that `<ip, port>`, because of the different `sysid`s. This should not happen.\r\n\r\nThis PR removes the `sysid` from the remotes, so that they are now identified with `<ip, port>`. I believe that the only consequence of that (apart from not sending duplicated messages) is that directed messages will be sent to all remotes instead of being filtered by `target_system_id`. I believe this is fine, because that's anyway the case for all the broadcast messages.\r\n\r\nNote: it seems to me that there was duplicated code there, too, that I removed. Not sure if that has consequences, but I don't think so.", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1177/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1177/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"actor": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2020-08-27T12:33:48Z", "updated_at": "2020-08-27T12:33:48Z", "source": {"type": "issue", "issue": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1181", "repository_url": "https://api.github.com/repos/mavlink/MAVSDK", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1181/labels{/name}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1181/comments", "events_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1181/events", "html_url"