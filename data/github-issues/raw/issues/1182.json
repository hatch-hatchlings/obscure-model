.com/users/cjffly/subscriptions", "organizations_url": "https://api.github.com/users/cjffly/orgs", "repos_url": "https://api.github.com/users/cjffly/repos", "events_url": "https://api.github.com/users/cjffly/events{/privacy}", "received_events_url": "https://api.github.com/users/cjffly/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2020-08-28T23:02:57Z", "updated_at": "2020-08-28T23:02:57Z", "body": "Thanks for the advise. I will try to do something on the RPi.\r\n\r\nIs it possible using MAVSDK to send a heartbeats just like what QGC did? ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/683182036/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "cjffly", "id": 11035640, "node_id": "MDQ6VXNlcjExMDM1NjQw", "avatar_url": "https://avatars.githubusercontent.com/u/11035640?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cjffly", "html_url": "https://github.com/cjffly", "followers_url": "https://api.github.com/users/cjffly/followers", "following_url": "https://api.github.com/users/cjffly/following{/other_user}", "gists_url": "https://api.github.com/users/cjffly/gists{/gist_id}", "starred_url": "https://api.github.com/users/cjffly/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/cjffly/subscriptions", "organizations_url": "https://api.github.com/users/cjffly/orgs", "repos_url": "https://api.github.com/users/cjffly/repos", "events_url": "https://api.github.com/users/cjffly/events{/privacy}", "received_events_url": "https://api.github.com/users/cjffly/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/683187623", "html_url": "https://github.com/mavlink/MAVSDK/issues/1182#issuecomment-683187623", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1182", "id": 683187623, "node_id": "MDEyOklzc3VlQ29tbWVudDY4MzE4NzYyMw==", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2020-08-28T23:23:55Z", "updated_at": "2020-08-28T23:23:55Z", "body": "The mavftp server example does it: https://github.com/mavlink/MAVSDK/blob/develop/examples/ftp_server/ftp_server.cpp#L43\r\n\r\nI wonder if you could do that [here](https://github.com/mavlink/MAVSDK/blob/develop/examples/takeoff_land/takeoff_and_land.cpp#L47):\r\n\r\n```c++\r\nconnection_result = mavsdk.setup_udp_remote(...);\r\n```\r\n\r\ninstead of \r\n\r\n```c++\r\nconnection_result = dc.add_any_connection(...);\r\n```\r\n\r\nIf you try it, let me know what happens :slightly_smiling_face: ", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/683187623/reactions", "total_coun