{"issue": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1320", "repository_url": "https://api.github.com/repos/mavlink/MAVSDK", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1320/labels{/name}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1320/comments", "events_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1320/events", "html_url": "https://github.com/mavlink/MAVSDK/issues/1320", "id": 810108808, "node_id": "MDU6SXNzdWU4MTAxMDg4MDg=", "number": 1320, "title": "Fail to build OpenSSL on macOS: \"fatal error: 'stdio.h' file not found\"", "user": {"login": "norisg", "id": 14205851, "node_id": "MDQ6VXNlcjE0MjA1ODUx", "avatar_url": "https://avatars.githubusercontent.com/u/14205851?v=4", "gravatar_id": "", "url": "https://api.github.com/users/norisg", "html_url": "https://github.com/norisg", "followers_url": "https://api.github.com/users/norisg/followers", "following_url": "https://api.github.com/users/norisg/following{/other_user}", "gists_url": "https://api.github.com/users/norisg/gists{/gist_id}", "starred_url": "https://api.github.com/users/norisg/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/norisg/subscriptions", "organizations_url": "https://api.github.com/users/norisg/orgs", "repos_url": "https://api.github.com/users/norisg/repos", "events_url": "https://api.github.com/users/norisg/events{/privacy}", "received_events_url": "https://api.github.com/users/norisg/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 6, "created_at": "2021-02-17T11:41:40Z", "updated_at": "2021-02-18T23:36:05Z", "closed_at": "2021-02-18T23:36:05Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summar