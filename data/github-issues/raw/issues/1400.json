="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/1402", "html_url": "https://github.com/mavlink/MAVSDK/pull/1402", "diff_url": "https://github.com/mavlink/MAVSDK/pull/1402.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/1402.patch", "merged_at": null}, "body": "Currently MissionProgress of class MissionRaw can't handle the case in which the vehicle stays at a mission item (either if this is the last mission item or the autocontinue flag is set to false). In this case the two messages CURRENT and REACHED conflict with each other. To differntiate between the current mission item and the last reached mission item a new property of MissionProgress `reached` is introduced . If a vehicle holds at a mission item `current` and `reached` will be identical. If the vehicle approaches another mission item `current` will be the sequence ID of the next mission item.\r\nThis fixes issue #1400.", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1402/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1402/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"id": 4568620724, "node_id": "MDE1OlJlZmVyZW5jZWRFdmVudDQ1Njg2MjA3MjQ=", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/4568620724", "actor": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubuser