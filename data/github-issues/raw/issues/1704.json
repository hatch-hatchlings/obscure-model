/MAVSDK/issues/comments/1047689722", "html_url": "https://github.com/mavlink/MAVSDK/issues/1704#issuecomment-1047689722", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1704", "id": 1047689722, "node_id": "IC_kwDOBabE0s4-cnn6", "user": {"login": "dsmits32", "id": 10809161, "node_id": "MDQ6VXNlcjEwODA5MTYx", "avatar_url": "https://avatars.githubusercontent.com/u/10809161?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dsmits32", "html_url": "https://github.com/dsmits32", "followers_url": "https://api.github.com/users/dsmits32/followers", "following_url": "https://api.github.com/users/dsmits32/following{/other_user}", "gists_url": "https://api.github.com/users/dsmits32/gists{/gist_id}", "starred_url": "https://api.github.com/users/dsmits32/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dsmits32/subscriptions", "organizations_url": "https://api.github.com/users/dsmits32/orgs", "repos_url": "https://api.github.com/users/dsmits32/repos", "events_url": "https://api.github.com/users/dsmits32/events{/privacy}", "received_events_url": "https://api.github.com/users/dsmits32/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-02-22T11:15:42Z", "updated_at": "2022-02-22T11:15:42Z", "body": "Thank you for your quick reply. Much appreciated.\r\n\r\nIt's in a Docker image build. So yes its a clean build. (Docker build with --no-cache option).\r\nHere is the Dockerfile, maybe it provides more info:\r\n\r\n```\r\nFROM arm64v8/ubuntu:bionic\r\n\r\nWORKDIR /home\r\n\r\nRUN apt-get update\r\nRUN apt-get install build-essential colordiff git doxygen wget libssl-dev -y\r\nRUN wget https://github.com/Kitware/CMake/releases/download/v3.23.0-rc1/cmake-3.23.0-rc1-linux-aarch64.sh \\\r\n    -q -O /tmp/cmake-install.sh \\\r\n    && chmod u+x /tmp/cmake-install.sh \\\r\n    && mkdir /usr/bin/cmake \\\r\n    && /tmp/cmake-install.sh --skip-license --prefix=/usr/bin/cmake \\\r\n    && rm /tmp/cmake-install.sh\r\n\r\nENV PATH=\"/usr/bin/cmake/bin:${PATH}\"\r\n\r\nRUN git clone https://github.com/mavlink/MAVSDK.git\r\nWORKDIR /home/MAVSDK\r\nRUN git checkout main\r\nRUN git submodule update --init --recursive\r\n\r\nRUN cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_MAVSDK_SERVER=ON -DCMAKE_INSTALL_PREFIX=install -Bbuild/default -H.\r\nRUN cmake --build build/default --target install\r\n```\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1047689722/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1047803992", "html_url": "https://github.com/mavlink/MAVSDK/issues/1704#issuecomment-1047803992", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1704", "id": 1047803992, "node_id": "IC_kwDOBabE0s4-dDhY", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events"