1058789415", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1711", "id": 1058789415, "node_id": "IC_kwDOBabE0s4_G9gn", "user": {"login": "dzywater", "id": 22073470, "node_id": "MDQ6VXNlcjIyMDczNDcw", "avatar_url": "https://avatars.githubusercontent.com/u/22073470?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dzywater", "html_url": "https://github.com/dzywater", "followers_url": "https://api.github.com/users/dzywater/followers", "following_url": "https://api.github.com/users/dzywater/following{/other_user}", "gists_url": "https://api.github.com/users/dzywater/gists{/gist_id}", "starred_url": "https://api.github.com/users/dzywater/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dzywater/subscriptions", "organizations_url": "https://api.github.com/users/dzywater/orgs", "repos_url": "https://api.github.com/users/dzywater/repos", "events_url": "https://api.github.com/users/dzywater/events{/privacy}", "received_events_url": "https://api.github.com/users/dzywater/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-03-04T03:24:59Z", "updated_at": "2022-03-06T21:06:24Z", "body": "![3](https://user-images.githubusercontent.com/22073470/156695761-1ff35d17-7b3b-4970-9db8-0b842ba9f7fc.png)\r\nuse \r\n\tmavsdk::Gimbal::ControlStatus ctl;// = gimbal->control();\r\n\tgimbal->subscribe_control([&ctl](mavsdk::Gimbal::ControlStatus v)->void { ctl = v; });\r\ninstead of \r\n\tmavsdk::Gimbal::ControlStatus ctl = gimbal->control();\r\nit is workable\r\n![3](https://user-images.githubusercontent.com/22073470/156696552-8e8b18f6-1f65-4d71-adcc-92651391d634.png)\r\n\r\n```\r\n#include <chrono>\r\n#include <iostream>\r\n#include <memory>\r\n#include <thread>\r\n#include <mavsdk/mavsdk.h>\r\n#include <mavsdk/system.h>\r\n#include <mavsdk/plugins/gimbal/gimbal.h>\r\n\r\nint main(int argc, char** argv)\r\n{\r\n\tmavsdk::Mavsdk mavsdk;\r\n\tmavsdk.add_udp_connection();\r\n\tstd::this_thread::sleep_for(std::chrono::seconds(2));\r\n\r\n\tif (mavsdk.systems().empty()) { std::cout << \"No system found\\n\";  return 1; }\r\n\tauto system = mavsdk.systems().at(0);\r\n\r\n\tif (!system->has_gimbal()) { std::cout << \"No gimbal found\\n\"; return 1; }\r\n\tauto gimbal = std::make_shared< mavsdk::Gimbal>(system);\r\n\r\n\tauto gimRet = gimbal->take_control(mavsdk::Gimbal::ControlMode::Primary);\r\n\tif (gimRet != mavsdk::Gimbal::Result::Success) { std::cout << std::endl << \"gimbal.take_control failed with \" << gimRet << std::endl; return 1; }\r\n\tmavsdk::Gimbal::ControlStatus ctl;// = gimbal->control();\r\n\tgimbal->subscribe_control([&ctl](mavsdk::Gimbal::ControlStatus v)->void { ctl = v; });\r\n\tfor (int k = 0; k < 5; ++k)\r\n\t{\r\n\t\tgimRet = gimbal->set_pitch_and_yaw(0, k * 90);\r\n\t\tif (gimRet != mavsdk::Gimbal::Result::Success) std::cout << \"gimbal.set_pitch_and_yaw failed with {}\" << gimRet << std::endl;\r\n\t\tstd::cout << ctl.control_mode << std::endl;\r\n\t\tstd::this_thread::sleep_for(std::chrono::seconds(5));\r\n\t}\r\n\treturn 0;\r\n}\r\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1058789415/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "dzywater", "id": 22073470, "node_id": "MDQ6VXNlcjIyMDczNDcw", "avatar_url": "https://avatars.githubusercontent.com/u/22073470?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dzywater", "html_url": "https://github.com/dzywater", "followers_url": "https://api.github.com/users/dzywater/followers", "following_url": "https://api.github.com/users/dzywater/following{/other_user}", "gists_url": "https://api.github.com/users/dzywater/gists{/gist_id}", "starred_url": "https://api.github.com/users/dzywater/starred{/owner}{/repo}", "subscrip