cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/1735", "html_url": "https://github.com/mavlink/MAVSDK/pull/1735", "diff_url": "https://github.com/mavlink/MAVSDK/pull/1735.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/1735.patch", "merged_at": "2022-04-14T02:38:11Z"}, "body": "As seen in #1728 the MAVLinkParameters is using some magic numbers to define the designated target component of the message,\r\n\r\nThis prevents the Camera plugin to read the parameters of the any camera other than the first.\r\n\r\nThis PR add some overloaded functions for the `set_param` and `get_params` actions that accept an additional target `component_id` parameter. \r\n\r\nThe Camera plugin as been updated to make use of this new functions.\r\n\r\n ", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1735/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1735/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"id": 6433720156, "node_id": "CE_lADOBabE0s5G_FIxzwAAAAF_esdc", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/6433720156", "actor": {"login": "persuader72", "id": 1241624, "node_id": "MDQ6VXNlcjEyNDE2MjQ=", "avatar_url": "https://avatars.githubusercontent.com/u/1241624?v=4", "gravatar_id": "", "url": "https://api.github.com/users/persuader72", "html_url": "https://github.com/persuader72", "followers_url": "https://api.github.com/users/persuader72/followers", "following_url": "https://api.github.com/users/persuader72/following{/other_user}", "gists_url": "https://api.github.com/users