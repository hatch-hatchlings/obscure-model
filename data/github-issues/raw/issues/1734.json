s/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1108379806", "html_url": "https://github.com/mavlink/MAVSDK/issues/1734#issuecomment-1108379806", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1734", "id": 1108379806, "node_id": "IC_kwDOBabE0s5CEIie", "user": {"login": "aaronj0", "id": 75925957, "node_id": "MDQ6VXNlcjc1OTI1OTU3", "avatar_url": "https://avatars.githubusercontent.com/u/75925957?v=4", "gravatar_id": "", "url": "https://api.github.com/users/aaronj0", "html_url": "https://github.com/aaronj0", "followers_url": "https://api.github.com/users/aaronj0/followers", "following_url": "https://api.github.com/users/aaronj0/following{/other_user}", "gists_url": "https://api.github.com/users/aaronj0/gists{/gist_id}", "starred_url": "https://api.github.com/users/aaronj0/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/aaronj0/subscriptions", "organizations_url": "https://api.github.com/users/aaronj0/orgs", "repos_url": "https://api.github.com/users/aaronj0/repos", "events_url": "https://api.github.com/users/aaronj0/events{/privacy}", "received_events_url": "https://api.github.com/users/aaronj0/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-04-25T10:21:44Z", "updated_at": "2022-04-25T10:21:44Z", "body": "> I'm not completely sure what the forwarding in QGC does. I would try using mavlink-router:\r\n> \r\n> * mavlink-router connects to the serial port\r\n> * mavlink-router sends mavlink to e.g. 14550 for QGC\r\n> * mavlink-router sends mavlink to e.g. 14540 for MAVSDK\r\n> \r\n> Would that make sense?\r\n\r\nYes mavlink router does solve the problem, thanks.\r\nAlthough I could not figure out why Telemetry forwarding in QGC did not work, it is supposed to forward the radio on a local udp port. But that's an issue for QGC :). Thanks!!", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1108379806/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "aaronj0", "id": 75925957, "node_id": "MDQ6VXNlcjc1OTI1OTU3", "avatar_url": "https://avatars.githubusercontent.com/u/75925957?v=4", "gravatar_id": "", "url": "https://api.github.com/users/aaronj0", "html_url": "https://github.com/aaronj0", "followers_url": "https://api.github.com/users/aaronj0/followers", "following_url": "https://api.github.com/users/aaronj0/following{/other_user}", "gists_url": "https://api.github.com/users/aaronj0/gists{/gist_id}", "starred_url": "https://api.github.com/users/aaronj0/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/aaronj0/subscriptions", "organizations_url": "https://api.github.com/users/aaronj0/orgs", "repos_url": "https://api.github.com/users/aaronj0/repos", "events_url": "https://api.github.com/users/aaronj0/events{/privacy}", "received_events_url": "https://api.github.com/users/aaronj0/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1108381390", "html_url": "https://github.com/mavlink/MAVSDK/issues/1734#issuecomment-1108381390", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1734", "id": 1108381390, "node_id": "IC_kwDOBabE0s5CEI7O", "user": {"login": "aaronj0", "id": 75925957, "node_id": "MDQ6VXNlcjc1OTI1OTU3", "avatar_url": "https://avatars.githubusercontent.com/u/75925957?v=4", "gravatar_id": "", "url": "https://api.github.com/users/aaronj0", "html_url": "https://github.com/aaronj0", "followers_url": "https://api.github.com/users/aaronj0/followers", "following_url": "https: