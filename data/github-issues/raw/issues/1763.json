/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-05-05T12:50:17Z", "updated_at": "2022-05-05T12:50:17Z", "body": "How did you install MAVSDK? And which version is that? Are you sure you are using the examples that correspond to your MAVSDK version? ", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1118508264/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1118521095", "html_url": "https://github.com/mavlink/MAVSDK/issues/1763#issuecomment-1118521095", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1763", "id": 1118521095, "node_id": "IC_kwDOBabE0s5Cq0cH", "user": {"login": "BaptisteG42", "id": 104975302, "node_id": "U_kgDOBkHLxg", "avatar_url": "https://avatars.githubusercontent.com/u/104975302?v=4", "gravatar_id": "", "url": "https://api.github.com/users/BaptisteG42", "html_url": "https://github.com/BaptisteG42", "followers_url": "https://api.github.com/users/BaptisteG42/followers", "following_url": "https://api.github.com/users/BaptisteG42/following{/other_user}", "gists_url": "https://api.github.com/users/BaptisteG42/gists{/gist_id}", "starred_url": "https://api.github.com/users/BaptisteG42/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/BaptisteG42/subscriptions", "organizations_url": "https://api.github.com/users/BaptisteG42/orgs", "repos_url": "https://api.github.com/users/BaptisteG42/repos", "events_url": "https://api.github.com/users/BaptisteG42/events{/privacy}", "received_events_url": "https://api.github.com/users/BaptisteG42/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-05-05T13:02:20Z", "updated_at": "2022-05-05T13:02:20Z", "body": "I've got it. I just used the command which is given at that link : https://mavsdk.mavlink.io/main/en/cpp/quickstart.html\r\nIt appears that, if you don't pay attention (and I didn't), you end up downloading the wrong version of the library (0.37.0) while you get the latest version of the MAVSDK repository. So as everyone could expect, it causes some compatibility issues.\r\n\r\nMy bad, and thank you @JonasVautherin for trying to help.\r\n\r\nSee ya !", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1118521095/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 1, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1118462698", "html_url": "https://github.com/mavlink/MAVSDK/issues/1763#issuecomment-1118462698", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1763", "id": 1118462698, "node_id": "IC_kwDOBabE0s5CqmLq", "user": {"login": "BaptisteG42", "id": 104975302, "node_id": "U_kgDOBkHLxg", "avatar_url": "https://avatars.githubusercontent.com/u/104975302?v=4", "gravatar_id": "", "url": "https://api.github.com/users/BaptisteG42", "html_url": "https://github.com/BaptisteG42", "followers_url": "https://api.github.com/users/BaptisteG42/followers", "following_url": "https://api.github.com/users/BaptisteG42/following{/other_user}", "gists_url": "https://api.github.com/users/BaptisteG42/gists{/gist_id}", "starred_url": "https://api.github.com/users/BaptisteG42/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/BaptisteG42/subscriptions", "organization