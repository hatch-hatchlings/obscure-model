rin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-05-19T13:27:48Z", "updated_at": "2022-05-19T13:27:48Z", "body": "I guess they should be added to the mavsdk mission plugin? Would you be willing to contribute that? :blush: ", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1131688393/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1132305794", "html_url": "https://github.com/mavlink/MAVSDK/issues/1778#issuecomment-1132305794", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1778", "id": 1132305794, "node_id": "IC_kwDOBabE0s5DfZ2C", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-05-19T23:49:19Z", "updated_at": "2022-05-19T23:49:19Z", "body": "@ankitatcodingnebula thanks for the note.\r\n\r\nFirst off: the mission plugin only supports a subset of commands. If you need all possible commands/mission items, you need to use the `MissionRaw` plugin instead.\r\n\r\nNow, for your specific commands, I can see how it would be nice to have support for them:\r\n1. MAV_CMD_NAV_TAKEOFF: there is work in progress to add support for this, see: #1628.\r\n2. MAV_CMD_SET_CAMERA_ACTION: given we support taking photos and videos in CameraAction it would seem logical that we also implement/support switching between photo and video mode. It would be nice to add that capability. The first step would be to add it here: https://github.com/mavlink/MAVSDK-Proto/blob/0c4379fb476b41f5193de7cd602e24668c0fb268/protos/mission/mission.proto#L222.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1132305794/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3006868402", "html_url": "https://github.com/mavlink/MAVSDK/issues/1778#issuecomment-3006868402", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1778", "id": 3006868402, "node_id": "IC_kwDOBabE0s6zOSuy", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-06-26T02:55:06Z", "updated_at": "2025-06-26T02:55:06Z", "body": "The QGC import is now just done in MissionRaw, so we don't have all the compatibility.\nClosing.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3006868402/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1131688393", "html_url": "https://github.com/mavlink/MAVSDK/issues/1778#issuecomment-1131688393", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1778", "id": 1131688393, "node_id": "IC_kwDOBabE0s5DdDHJ", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/Jona