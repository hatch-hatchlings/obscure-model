.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-07-07T18:08:08Z", "updated_at": "2022-07-07T18:08:08Z", "body": "511 is https://mavlink.io/en/messages/common.html#MAV_CMD_SET_MESSAGE_INTERVAL\r\n\r\nDoes Arduplace support it?", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1178020603/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1178152214", "html_url": "https://github.com/mavlink/MAVSDK/issues/1846#issuecomment-1178152214", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1846", "id": 1178152214, "node_id": "IC_kwDOBabE0s5GOS0W", "user": {"login": "linuxguy123", "id": 1920754, "node_id": "MDQ6VXNlcjE5MjA3NTQ=", "avatar_url": "https://avatars.githubusercontent.com/u/1920754?v=4", "gravatar_id": "", "url": "https://api.github.com/users/linuxguy123", "html_url": "https://github.com/linuxguy123", "followers_url": "https://api.github.com/users/linuxguy123/followers", "following_url": "https://api.github.com/users/linuxguy123/following{/other_user}", "gists_url": "https://api.github.com/users/linuxguy123/gists{/gist_id}", "starred_url": "https://api.github.com/users/linuxguy123/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/linuxguy123/subscriptions", "organizations_url": "https://api.github.com/users/linuxguy123/orgs", "repos_url": "https://api.github.com/users/linuxguy123/repos", "events_url": "https://api.github.com/users/linuxguy123/events{/privacy}", "received_events_url": "https://api.github.com/users/linuxguy123/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-07-07T19:54:48Z", "updated_at": "2022-07-07T19:54:48Z", "body": "I just found this:\r\n\r\n\"Send a [SET_MESSAGE_INTERVAL](https://mavlink.io/en/messages/common.html#MAV_CMD_SET_MESSAGE_INTERVAL) command (within a [COMMAND_LONG](https://mavlink.io/en/messages/common.html#COMMAND_LONG) message) to precisely control the rate of an individual message. Note this is only supported on ArduPilot 4.0 and higher\"\r\n\r\nhttps://ardupilot.org/dev/docs/mavlink-requesting-data.html\r\n\r\nI'll update Arduplane and report back.\r\n\r\n\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1178152214/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1178471757", "html_url": "https://github.com/mavlink/MAVSDK/issues/1846#issuecomment-1178471757", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1846", "id": 1178471757, "node_id": "IC_kwDOBabE0s5GPg1N", "user": {"login": "linuxguy123", "id": 1920754, "node_id": "MDQ6VXNlcjE5MjA3NTQ=", "avatar_url": "https://avatars.githubusercontent.com/u/1920754?v=4", "gravatar_id": "", "url": "https://api.github.com/users/linuxguy123", "html_url": "https://github.com/linuxguy123", "followers_url": "https://api.github.com/users/linuxguy123/followers", "following_url": "https://api.github.com/users/linuxguy123/following{/other_user}", "gists_url": "https://api.github.com/users/linuxguy123/gists{/gist_id}", "star