_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "It would be nice to support multiple architectures (at least arm64) and tag images with MAVSDK release tag.\r\n\r\n---\r\n\r\nCurrently images at the [DockerHub](https://hub.docker.com/u/mavsdk) are not tagged with the MAVSDK release which means it is not possible to freeze the version of a dockerized MAVSDK.\r\n\r\nAlso I am a bit confused: there is a relatively new [`mavsdk-ubuntu-22.04`](https://hub.docker.com/r/mavsdk/mavsdk-ubuntu-22.04) image but it is not listed in [`build_and_push_docker_images.sh`](https://github.com/mavlink/MAVSDK/blob/main/docker/build_and_push_docker_images.sh) while [`mavsdk-ubuntu-20.04) `](https://hub.docker.com/r/mavsdk/mavsdk-ubuntu-20.04) was updated 3 months ago (there latter is present in the file).\r\n", "closed_by": {"login": "Sitin", "id": 1565939, "node_id": "MDQ6VXNlcjE1NjU5Mzk=", "avatar_url": "https://avatars.githubusercontent.com/u/1565939?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sitin", "html_url": "https://github.com/Sitin", "followers_url": "https://api.github.com/users/Sitin/followers", "following_url": "https://api.github.com/users/Sitin/following{/other_user}", "gists_url": "https://api.github.com/users/Sitin/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sitin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sitin/subscriptions", "organizations_url": "https://api.github.com/users/Sitin/orgs", "repos_url": "https://api.github.com/users/Sitin/repos", "events_url": "https://api.github.com/users/Sitin/events{/privacy}", "received_events_url": "https://api.github.com/users/Sitin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1870/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github