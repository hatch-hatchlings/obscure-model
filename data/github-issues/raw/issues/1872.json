irii/gists{/gist_id}", "starred_url": "https://api.github.com/users/PeymanAmirii/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/PeymanAmirii/subscriptions", "organizations_url": "https://api.github.com/users/PeymanAmirii/orgs", "repos_url": "https://api.github.com/users/PeymanAmirii/repos", "events_url": "https://api.github.com/users/PeymanAmirii/events{/privacy}", "received_events_url": "https://api.github.com/users/PeymanAmirii/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-08-02T08:52:21Z", "updated_at": "2022-08-02T08:59:16Z", "body": "Thanks for your answer. We want to see if a P controller with acceleration command can be more accurate than a P controller with velocity command or not. Is it possible to find out why when we use the command set_acceleration_ned(AccelerationNed(0, 0, 0)), the drones descent (however, they should stay at a point), but when we use the command set_velocity_ned(VelocityNed(0, 0, 0)), they stay at a point?\r\n\r\n(We have developed a framework named Helix.io to control mutiple drones using MAVSDK library. The link to framework is:\r\nhttps://github.com/CUEDOS/helixio)\r\nThanks.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1202204889/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "PeymanAmirii", "id": 93652974, "node_id": "U_kgDOBZUH7g", "avatar_url": "https://avatars.githubusercontent.com/u/93652974?v=4", "gravatar_id": "", "url": "https://api.github.com/users/PeymanAmirii", "html_url": "https://github.com/PeymanAmirii", "followers_url": "https://api.github.com/users/PeymanAmirii/followers", "following_url": "https://api.github.com/users/PeymanAmirii/following{/other_user}", "gists_url": "https://api