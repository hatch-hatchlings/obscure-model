s": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1206040630", "html_url": "https://github.com/mavlink/MAVSDK/issues/1879#issuecomment-1206040630", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1879", "id": 1206040630, "node_id": "IC_kwDOBabE0s5H4rg2", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-08-05T04:51:50Z", "updated_at": "2022-08-05T04:51:50Z", "body": "This might be because PX4 no longer runs mavlink on USB by default but only after you send it heartbeats.\r\n\r\nTry opening the question with the option to send heartbeats.\r\nhttps://github.com/mavlink/MAVSDK/blob/425577aa5629d591a854a65fd1f2dd6d88b526d9/src/mavsdk/core/include/mavsdk/mavsdk.h#L199-L200", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1206040630/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 1, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1206451093", "html_url": "https://github.com/mavlink/MAVSDK/issues/1879#issuecomment-1206451093", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1879", "id": 1206451093, "node_id": "IC_kwDOBabE0s5H6PuV", "user": {"login": "weagle08", "id": 7888478, "node_id": "MDQ6VXNlcjc4ODg0Nzg=", "avatar_url": "https://avatars.githubusercontent.com/u/7888478?v=4", "gravatar_id": "", "url": "https://api.github.com/users/weagle08", "html_url": "https://github.com/weagle08", "followers_url": "https://api.github.com/users/weagle08/followers", "following_url": "https://api.github.com/users/weagle08/following{/other_user}", "gists_url": "https://api.github.com/users/weagle08/gists{/gist_id}", "starred_url": "https://api.github.com/users/weagle08/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/weagle08/subscriptions", "organizations_url": "https://api.github.com/users/weagle08/orgs", "repos_url": "https://api.github.com/users/weagle08/repos", "events_url": "https://api.github.com/users/weagle08/events{/privacy}", "received_events_url": "https://api.github.com/users/weagle08/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-08-05T13:18:51Z", "updated_at": "2022-08-05T13:18:51Z", "body": "That works! Thanks for the quick response!\r\n```c++\r\nmavsdk::Mavsdk::Configuration sdkConfig(mavsdk::Mavsdk::Configuration::UsageType::CompanionComputer);\r\nsdkConfig.set_always_send_heartbeats(true);\r\nsdkConfig.set_system_id(this->_fcSystem->get_system_id());\r\nsdkConfig.set_component_id(this->_fcSystem->component_ids().front());\r\nthis->_msdk->set_configuration(sdkConfig);\r\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1206451093/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 1, "rocket": 0,