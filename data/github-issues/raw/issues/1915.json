d point! This looks wrong but it's probably working correctly because the MAVLink message type itself is `_INT` and so the autopilot knows how to interpret the data.\r\n\r\nI'm not sure if this was on purpose given what was expected by PX4, or done by QGC, and so it just matches it, or if this is an oversight and wrong (but working).\r\n\r\nIt would be interesting if you could check if this matters and what QGC does.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1282992528/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4157919649", "html_url": "https://github.com/mavlink/MAVSDK/issues/1915#issuecomment-4157919649", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1915", "id": 4157919649, "node_id": "IC_kwDOBabE0s731NGh", "user": {"login": "PavelGuzenfeld", "id": 67074795, "node_id": "MDQ6VXNlcjY3MDc0Nzk1", "avatar_url": "https://avatars.githubusercontent.com/u/67074795?v=4", "gravatar_id": "", "url": "https://api.github.com/users/PavelGuzenfeld", "html_url": "https://github.com/PavelGuzenfeld", "followers_url": "https://api.github.com/users/PavelGuzenfeld/followers", "following_url": "https://api.github.com/users/PavelGuzenfeld/following{/other_user}", "gists_url": "https://api.github.com/users/PavelGuzenfeld/gists{/gist_id}", "starred_url": "https://api.github.com/users/PavelGuzenfeld/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/PavelGuzenfeld/subscriptions", "organizations_url": "https://api.github.com/users/PavelGuzenfeld/orgs", "repos_url": "https://api.github.com/users/PavelGuzenfeld/repos", "events_url": "https://api.github.com/users/PavelGuzenfeld/events{/privacy}", "received_events_url": "https://api.github.com/users/PavelGuzen