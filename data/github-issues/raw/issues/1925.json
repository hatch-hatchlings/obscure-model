{"issue": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1925", "repository_url": "https://api.github.com/repos/mavlink/MAVSDK", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1925/labels{/name}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1925/comments", "events_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1925/events", "html_url": "https://github.com/mavlink/MAVSDK/issues/1925", "id": 1437527592, "node_id": "I_kwDOBabE0s5Vru4o", "number": 1925, "title": "Latest QGC Fixed Wing Landing format will not parse using MAVSDK mission import", "user": {"login": "jjb14", "id": 12084004, "node_id": "MDQ6VXNlcjEyMDg0MDA0", "avatar_url": "https://avatars.githubusercontent.com/u/12084004?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jjb14", "html_url": "https://github.com/jjb14", "followers_url": "https://api.github.com/users/jjb14/followers", "following_url": "https://api.github.com/users/jjb14/following{/other_user}", "gists_url": "https://api.github.com/users/jjb14/gists{/gist_id}", "starred_url": "https://api.github.com/users/jjb14/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jjb14/subscriptions", "organizations_url": "https://api.github.com/users/jjb14/orgs", "repos_url": "https://api.github.com/users/jjb14/repos", "events_url": "https://api.github.com/users/jjb14/events{/privacy}", "received_events_url": "https://api.github.com/users/jjb14/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [{"id": 1594597435, "node_id": "MDU6TGFiZWwxNTk0NTk3NDM1", "url": "https://api.github.com/repos/mavlink/MAVSDK/labels/feature", "name": "feature", "color": "2be2be", "default": false, "description": ""}], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 1, "created_at": "2022-11-06T20:20:44Z", "updated_at": "2025-10-03T00:11:25Z", "closed_at": "2025-10-03T00:11:25Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "The latest QGroundControl (QGC) version (I\u2019m currently running v4.2.3) has a fixed wing landing \u201csequence\u201d or \u201csyntax\u201d that is not recognized by the MAVSDK parsing routine (I believe MAVSDK is not up to date on the latest QGC landing \u201csyntax\u201d). This is evidenced by the fact that an unedited working QGC mission exported to \u201c.plan\u201d format will not re-import using the MAVSDK \u201cmission_import.py\u201d script in the MAVSDK examples due to a parsing error. I can, however, get around this by manually creating MAV_CMD_DO_LAND_START & MAV_CMD_NAV_LAND mission items (essentially defining a landing as per older versions of QGC).", "closed_by": {"login": "jjb14", "id": 12084004, "node_id": "MDQ6VXNlcjEyMDg0MDA0", "avatar_url": "https://avatars.githubusercontent.com/u/12084004?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jjb14", "html_url": "https://github.com/jjb14", "followers_url": "https://api.github.com/users/jjb14/followers", "following_url": "https://api.github.com/users/jjb14/following{/other_user}", "gists_url": "https://api.github.com/users/jjb14/gists{/gist_id}", "starred_url": "https://api.github.com/users/jjb14/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jjb14/subscriptions", "organizations_url": "https://api.github.com/users/jjb14/orgs", "repos_url": "https://api.github.com/users/jjb14/repos", "events_url": "https://api.github.com/users/jjb14/events{/privacy}", "received_events_url": "https://api.github.com/users/jjb14/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1925/reactions", "to