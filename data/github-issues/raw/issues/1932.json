ithub.com/mavlink/MAVSDK/issues/1932#issuecomment-1326888270", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1932", "id": 1326888270, "node_id": "IC_kwDOBabE0s5PFrVO", "user": {"login": "Decerguyer", "id": 76597563, "node_id": "MDQ6VXNlcjc2NTk3NTYz", "avatar_url": "https://avatars.githubusercontent.com/u/76597563?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Decerguyer", "html_url": "https://github.com/Decerguyer", "followers_url": "https://api.github.com/users/Decerguyer/followers", "following_url": "https://api.github.com/users/Decerguyer/following{/other_user}", "gists_url": "https://api.github.com/users/Decerguyer/gists{/gist_id}", "starred_url": "https://api.github.com/users/Decerguyer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Decerguyer/subscriptions", "organizations_url": "https://api.github.com/users/Decerguyer/orgs", "repos_url": "https://api.github.com/users/Decerguyer/repos", "events_url": "https://api.github.com/users/Decerguyer/events{/privacy}", "received_events_url": "https://api.github.com/users/Decerguyer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-11-24T23:18:32Z", "updated_at": "2022-12-03T18:35:35Z", "body": "Try to give this code a shot. Thanks for the help\r\n```\r\nvoid minimal_example(){\r\n    std::cout << \"Minimal Example\" << std::endl;\r\n    Mavsdk mavsdk;\r\n    //ConnectionResult connection_result = mavsdk.add_any_connection(argv[1]);\r\n    ConnectionResult connection_result = mavsdk.add_any_connection(\"serial:///dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AQ02BVZE-if00-port0:57600\");\r\n    if (connection_result != ConnectionResult::Success)\r\n    {\r\n        std::cerr << \"Connection failed: \" << connection_result << '\\n';\r\n    }\r\n    auto system = get_system(mavsdk);\r\n    auto action = new mavsdk::Action(system);\r\n    auto offboard = new mavsdk::Offboard(system);\r\n    auto telemetry = new mavsdk::Telemetry(system);\r\n    auto mavlink_passthrough = new mavsdk::MavlinkPassthrough(system);\r\n\r\n    mavlink_passthrough->subscribe_message_async(65, [](const mavlink_message_t &msg_raw)\r\n{\r\n    const mavlink_message_t* msg = &msg_raw;\r\n    std::cout << \"Recieved RC Transmission: \" << std::endl;\r\n\r\n    mavlink_rc_channels_t *rc_channels;\r\n    mavlink_msg_rc_channels_decode(msg, rc_channels);\r\n\r\n    std::cout << \"Number of channels received: \" << int(rc_channels->chancount) << std::endl;\r\n    std::cout << \"Channel 8: \" << rc_channels->chan8_raw << std::endl;\r\n}  \r\n);\r\nwhile(1);\r\n}\r\n\r\nstd::shared_ptr<mavsdk::System> get_system(mavsdk::Mavsdk &mavsdk)\r\n{\r\n    std::cout << \"Waiting to discover system...\\n\";\r\n    auto prom = std::promise<std::shared_ptr<System>>{};\r\n    auto fut = prom.get_future();\r\n\r\n    // We wait for new systems to be discovered, once we find one that has an\r\n    // autopilot, we decide to use it.\r\n    mavsdk.subscribe_on_new_system([&mavsdk, &prom]()\r\n                                   {\r\n        auto system = mavsdk.systems().back();\r\n\r\n        if (system->has_autopilot()) {\r\n            std::cout << \"Discovered autopilot\\n\";\r\n\r\n            // Unsubscribe again as we only want to find one system.\r\n            mavsdk.subscribe_on_new_system(nullptr);\r\n            prom.set_value(system);\r\n        } });\r\n\r\n    // We usually receive heartbeats at 1Hz, therefore we should find a\r\n    // system after around 3 seconds max, surely.\r\n    if (fut.wait_for(seconds(3)) == std::future_status::timeout)\r\n    {\r\n        std::cerr << \"No autopilot found.\\n\";\r\n        return {};\r\n    }\r\n\r\n    return fut.get();\r\n}\r\n```\r\n\r\nThe terminal output looks as follows:\r\n![Screen Shot 2022-11-24 at 7 04 56 PM](https://user-images.githubusercontent.com/76597563/203876479-c9a31698-4b24-4fa0-b63c-51eab9a708a7.png)\r\n", "author_association": "NONE", "pin": null,