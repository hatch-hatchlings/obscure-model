ues/comments/1349633295/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1345336615", "html_url": "https://github.com/mavlink/MAVSDK/issues/1941#issuecomment-1345336615", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1941", "id": 1345336615, "node_id": "IC_kwDOBabE0s5QMDUn", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2022-12-10T17:07:21Z", "updated_at": "2022-12-10T17:07:21Z", "body": "If you install MAVSDK from a package, you should use the examples that correspond to its version. Say you install MAVSDK 1.4.7, you should run the examples from tag `v1.4.7` (and not from `main`).\r\n\r\nIf you compile MAVSDK from source, you should run the corresponding examples. Say you compile MAVSDK from `main`, you should use the examples on `main`.\