tal_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "As the return value of the API only denotes success of message sent to pixhawk, not the completion of the API.\r\nThere is no way to know if the drone has reached to the destination Lat/Long. \r\n\r\nShould we need to monitor telemetry position callback to check if the drone is on right path and do an estimation based on speed and angle and predict lat long ?\r\n\r\nPlease guide\r\n\r\n-Thanks", "closed_by": {"login": "mjemv", "id": 73298972, "node_id": "MDQ6VXNlcjczMjk4OTcy", "avatar_url": "https://avatars.githubusercontent.com/u/73298972?v=4", "gravatar_id": "", "url": "https://api.github.com/users/mjemv", "html_url": "https://github.com/mjemv", "followers_url": "https://api.github.com/users/mjemv/followers", "following_url": "https://api.github.com/users/mjemv/following{/other_user}", "gists_url": "https://api.github.com/users/mjemv/gists{/gist_id}", "starred_url": "https://api.github.com/users/mjemv/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/mjemv/subscriptions", "organizations_url": "https://api.github.com/users/mjemv/orgs", "repos_url": "https://api.github.com/users/mjemv/repos", "events_url": "https://api.github.com/users/mjemv/events{/privacy}", "received_events_url": "https://api.github.com/users/mjemv/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1957/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/1957/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, "comments": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1398444533", "html_url": "https://github.com/mavlink/MAVSDK/issues/1957#issuecomment-1398444533", "issue_url": "https://api.githu