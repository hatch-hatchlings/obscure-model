d mavsdk_impl.cpp:546\r\nstd::__invoke_impl<\u2026> invoke.h:73\r\nstd::__invoke<\u2026> invoke.h:95\r\nstd::thread::_Invoker::_M_invoke<\u2026> thread:244\r\nstd::thread::_Invoker::operator() thread:251\r\nstd::thread::_State_impl::_M_run thread:195\r\n<unknown> 0x00007fffe531fde4\r\nstart_thread 0x00007ffff34ee609\r\nclone 0x00007fffe500a133\r\n```", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1536295305/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1536295305", "html_url": "https://github.com/mavlink/MAVSDK/issues/2030#issuecomment-1536295305", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2030", "id": 1536295305, "node_id": "IC_kwDOBabE0s5bkgGJ", "user": {"login": "elbarto1980", "id": 36400622, "node_id": "MDQ6VXNlcjM2NDAwNjIy", "avatar_url": "https://avatars.githubusercontent.com/u/36400622?v=4", "gravatar_id": "", "url": "https://api.github.com/users/elbarto1980", "html_url": "https://github.com/elbarto1980", "followers_url": "https://api.github.com/users/elbarto1980/followers", "following_url": "https://api.github.com/users/elbarto1980/following{/other_user}", "gists_url": "https://api.github.com/users/elbarto1980/gists{/gist_id}", "starred_url": "https://api.github.com/users/elbarto1980/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/elbarto1980/subscriptions", "organizations_url": "https://api.github.com/users/elbarto1980/orgs", "repos_url": "https://api.github.com/users/elbarto1980/repos", "events_url": "https://api.github.com/users/elbarto1980/events{/privacy}", "received_events_url": "https://api.github.com/users/elbarto1980/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "c