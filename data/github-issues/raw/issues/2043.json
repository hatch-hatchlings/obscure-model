nizations_url": "https://api.github.com/users/ygratz/orgs", "repos_url": "https://api.github.com/users/ygratz/repos", "events_url": "https://api.github.com/users/ygratz/events{/privacy}", "received_events_url": "https://api.github.com/users/ygratz/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-06-05T06:19:30Z", "updated_at": "2023-06-05T06:19:30Z", "body": "[tlapik123](https://github.com/tlapik123) hi,\r\ncan you be more specific on how you use the fetchContent?\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1576114040/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1576474319", "html_url": "https://github.com/mavlink/MAVSDK/issues/2043#issuecomment-1576474319", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2043", "id": 1576474319, "node_id": "IC_kwDOBabE0s5d9xbP", "user": {"login": "tlapik123", "id": 56395607, "node_id": "MDQ6VXNlcjU2Mzk1NjA3", "avatar_url": "https://avatars.githubusercontent.com/u/56395607?v=4", "gravatar_id": "", "url": "https://api.github.com/users/tlapik123", "html_url": "https://github.com/tlapik123", "followers_url": "https://api.github.com/users/tlapik123/followers", "following_url": "https://api.github.com/users/tlapik123/following{/other_user}", "gists_url": "https://api.github.com/users/tlapik123/gists{/gist_id}", "starred_url": "https://api.github.com/users/tlapik123/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/tlapik123/subscriptions", "organizations_url": "https://api.github.com/users/tlapik123/orgs", "repos_url": "https://api.github.com/users/tlapik123/repos", "events_url": "https://api.github.com/users/tlapik123/events{/privacy}", "received_events_url": "https://api.github.com/users/tlapik123/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-06-05T09:45:11Z", "updated_at": "2023-06-05T09:45:46Z", "body": "> [tlapik123](https://github.com/tlapik123) hi, can you be more specific on how you use the fetchContent?\r\n\r\nSure! Here is the code.\r\n\r\n```cmake\r\ninclude(FetchContent)\r\n\r\nset(PACKAGE_NAME mavsdk)\r\n\r\nFetchContent_Declare(\r\n    ${PACKAGE_NAME}\r\n    GIT_REPOSITORY https://github.com/mavlink/MAVSDK.git\r\n    GIT_TAG 3cd9aa992b8defe9687db3a6b71964363cd0f63b\r\n)\r\n\r\nFetchContent_GetProperties(${PACKAGE_NAME})\r\nif(NOT ${PACKAGE_NAME}_POPULATED)\r\n    FetchContent_Populate(${PACKAGE_NAME})\r\n\r\n    add_subdirectory(${${PACKAGE_NAME}_SOURCE_DIR} ${${PACKAGE_NAME}_BINARY_DIR} EXCLUDE_FROM_ALL)\r\nendif()\r\n```\r\nYou can use the latest commit instead of commit provided.\r\n\r\nYou can include this in your *CMakeLists.txt* directly or you can create a separate *.cmake* file somewhere and include it with `include(<relative path to .cmake file>)`\r\n\r\nThen in the *CMakeLists.txt* you need to link against it.\r\n\r\n```cmake\r\n# link against mavsdk\r\ntarget_link_libraries(<your target here>\r\n    PRIVATE mavsdk\r\n)\r\n```\r\n\r\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1576474319/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1556296997", "html_url": "https://github.com/mavlink/MAVSDK/issues/2043#issuecomment-1556296997", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2043", "id": 1556296997, "node_id": "IC_kwDOBabE0s5cwzUl", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avata