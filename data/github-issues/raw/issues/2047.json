k/MAVSDK/issues/2047/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, "comments": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1558050502", "html_url": "https://github.com/mavlink/MAVSDK/issues/2047#issuecomment-1558050502", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2047", "id": 1558050502, "node_id": "IC_kwDOBabE0s5c3fbG", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-05-22T21:38:09Z", "updated_at": "2023-05-22T21:38:09Z", "body": "Interesting. Are you checking this on the same link, so would it be the exact same number of messages?\r\nI'm asking because different links from PX4 can send at different rates.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1558050502/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1558116460", "html_url": "https://github.com/mavlink/MAVSDK/issues/2047#issuecomment-1558116460", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2047", "id": 1558116460, "node_id": "IC_kwDOBabE0s5c3vhs", "user": {"login": "StefanoColli", "id": 45536733, "node_id": "MDQ6VXNlcjQ1NTM2NzMz", "avatar_url": "https://avatars.githubusercontent.com/u/45536733?v=4", "gravatar_id": "", "url": "https://api.github.com/users/StefanoColli", "html_url": "https://github.com/StefanoColli", "followers_url": "https://api.github.com/users/StefanoColli/followers", "following_url": "https://api.github.com/users/StefanoColli/following{/other_user}", "gists_url": "https://api.github.com/users/StefanoColli/gists{/gist_id}", "starred_url": "https://api.github.com/users/StefanoColli/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/StefanoColli/subscriptions", "organizations_url": "https://api.github.com/users/StefanoColli/orgs", "repos_url": "https://api.github.com/users/StefanoColli/repos", "events_url": "https://api.github.com/users/StefanoColli/events{/privacy}", "received_events_url": "https://api.github.com/users/StefanoColli/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-05-22T22:29:18Z", "updated_at": "2023-05-22T22:29:18Z", "body": "Thanks for the fast reply!\r\nMy application is connecting through udp://:14540 (to use the offboard flight mode), while QGC is connected through serial (I believe). Can that be the problem? ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1558116460/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1560139745", "html_url": "https://github.com/mavlink/MAVSDK/issues/2047#issuecomment-1560139745", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2047", "id": 1560139745, "node_id": "IC_kwDOBabE0s5c_dfh", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-05-23T21:23:02Z", "updated_at": "2023-05-23T21:23:02Z", "body": "Right, so the rate might indeed be different. You can try to set the rate using the command https://mavlink.io/en/messages/common.html#MAV_CMD_SET_MESSAGE_INTERVAL.\r\n\r\nOr you can set it on the PX4 side here:\r\nhttps://github.com/PX4/PX4-Autopilot/blob/main/ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink#L26\r\nusing:\r\n\r\n```\r\nmavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_offboard_port_local\r\n```", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1560139745/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_ap