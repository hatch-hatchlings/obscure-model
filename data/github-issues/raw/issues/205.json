21/orgs", "repos_url": "https://api.github.com/users/Kiwa21/repos", "events_url": "https://api.github.com/users/Kiwa21/events{/privacy}", "received_events_url": "https://api.github.com/users/Kiwa21/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2017-12-19T20:41:54Z", "updated_at": "2017-12-19T20:41:54Z", "body": "That would be real nice IMO !", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/352880243/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/352897075", "html_url": "https://github.com/mavlink/MAVSDK/issues/205#issuecomment-352897075", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/205", "id": 352897075, "node_id": "MDEyOklzc3VlQ29tbWVudDM1Mjg5NzA3NQ==", "user": {"login": "hamishwillee", "id": 5368500, "node_id": "MDQ6VXNlcjUzNjg1MDA=", "avatar_url": "https://avatars.githubusercontent.com/u/5368500?v=4", "gravatar_id": "", "url": "https://api.github.com/users/hamishwillee", "html_url": "https://github.com/hamishwillee", "followers_url": "https://api.github.com/users/hamishwillee/followers", "following_url": "https://api.github.com/users/hamishwillee/following{/other_user}", "gists_url": "https://api.github.com/users/hamishwillee/gists{/gist_id}", "starred_url": "https://api.github.com/users/hamishwillee/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/hamishwillee/subscriptions", "organizations_url": "https://api.github.com/users/hamishwillee/orgs", "repos_url": "https://api.github.com/users/hamishwillee/repos", "events_url": "https://api.github.com/users/hamishwillee/events{/privacy}", "received_events_url": "https://api.github.com/users/hamishwillee/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2017-12-19T21:50:51Z", "updated_at": "2017-12-19T21:50:51Z", "body": "We would love to support other MAVLink autopilots, but:\r\n1. Our main priority is rock solid performance on Dronecode platform. \r\n2. We don't have time or resources to maintain the port.\r\n\r\nSo the short answer is yes, but only if the person making the contributions commits to maintaining them and helps to put in place the infrastructure needed to test them. \r\n\r\nAs an aside I think that as long as the `DroneCore` and `Device` classes work OK with another autopilot, the new architecture would give us lots of choices about how we might support said autopilot in the plugins.\r\n\r\n@julianoes Is that a fair assessment of our position?", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/352897075/reactions", "total_count": 4, "+1": 4, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/352880243", "html_url": "https://github.com/mavlink/MAVSDK/issues/205#issuecomment-352880243", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/205", "id": 352880243, "node_id": "MDEyOklzc3VlQ29tbWVudDM1Mjg4MDI0Mw==", "user": {"login": "Kiwa21", "id": 15262932, "node_id": "MDQ6VXNlcjE1MjYyOTMy", "avatar_url": "https://avatars.githubusercontent.com/u/15262932?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Kiwa21", "html_url": "https://github.com/Kiwa21", "followers_url": "https://api.github.com/users/Kiwa21/followers", "following_url": "https://api.github.com/users/Kiwa21/following{/other_user}", "gists_url": "https://api.github.com/users/Kiwa21/gists{/gist_id}", "starred_url": "https://api.github.com/users/Kiwa21/starred{/owner}{/repo}", "subscriptions_url": "https://api.git