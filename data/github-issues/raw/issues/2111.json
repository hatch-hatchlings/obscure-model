.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-11T00:32:53Z", "updated_at": "2023-08-11T00:32:53Z", "body": "I would be ok with sending another command for ArduPilot.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1674087009/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1674378168", "html_url": "https://github.com/mavlink/MAVSDK/issues/2111#issuecomment-1674378168", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2111", "id": 1674378168, "node_id": "IC_kwDOBabE0s5jzPu4", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-11T08:23:06Z", "updated_at": "2023-08-11T08:23:06Z", "body": "Same, I like the idea of the `if` statement, sending SET_SERVO for Ardupilot and SET_ACTUATOR for PX4:\r\n\r\n```\r\nif (_system_impl->autopilot() == SystemImpl::Autopilot::ArduPilot) { \r\n```", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1674378168/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1675065352", "html_url": "https://github.com/mavlink/MAVSDK/issues/2111#issuecomment-1675065352", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2111", "id": 1675065352, "node_id": "IC_kwDOBabE0s5j13gI", "user": {"login": "trolledbypro", "id": 57928210, "node_id": "MDQ6VXNlcjU3OTI4MjEw", "avatar_url": "https://avatars.githubusercontent.com/u/57928210?v=4", "gravatar_id": "", "url": "https://api.github.com/users/trolledbypro", "html_url": "https://github.com/trolledbypro", "followers_url": "https://api.github.com/users/trolledbypro/followers", "following_url": "https://api.github.com/users/trolledbypro/following{/other_user}", "gists_url": "https://api.github.com/users/trolledbypro/gists{/gist_id}", "starred_url": "https://api.github.com/users/trolledbypro/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/trolledbypro/subscriptions", "organizations_url": "https://api.github.com/users/trolledbypro/orgs", "repos_url": "https://api.github.com/users/trolledbypro/repos", "events_url": "https://api.github.com/users/trolledbypro/events{/privacy}", "received_events_url": "https://api.github.com/users/trolledbypro/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-11T16:33:17Z", "updated_at": "2023-08-11T16:35:22Z", "body": "I implemented it in my fork: \r\nhttps://github.com/mavlink/MAVSDK/compare/main...trolledbypro:MAVSDK:pr-ardupilot-set-servo\r\n\r\nLooks like this is all that needs to change to get it working on ArduPilot. The two commands are equivalent due to DO_SET_ACTUATOR only being used to change one actuator at a time.\r\n\r\nI'll submit a PR after some more testing, but this code is working with my ArduPilot SITL running set_actuator.\r\n\r\n@julianoes How much testing/what testing do I need to do before I can submit a PR?", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1675065352/reactions", "total_count": 2, "+1": 0, "-1": 0, "laugh": 0, "hooray": 2, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1675249261", "html_url": "https://github.com/mavlink/MAVSDK/issues/2111#issuecomment-1675249261", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2111", "id": 1675249261, "node_id": "IC_kwDOBabE0s5j2kZt", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-11T19:14:04Z", "updated_at": "2023-08-11T19:14:04Z", "body": "> How much testing/what testing do I need to do before I can submit a PR?\r\n\r\nIf it works for you, just open a PR. It is currently not working for Ardupilot anyway, and your change should be low-risk for PX4 since you have a pretty clean `if (ardupilot)` condition :+1:.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1675249261/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2133053797", "html_url": "https://github.com/mavlink/MAVSDK/issues/2111#issuecomment-2133053797", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2111", "id": 2133053797, "node_id": "IC_kwDOBabE0s5_I9Fl", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/org