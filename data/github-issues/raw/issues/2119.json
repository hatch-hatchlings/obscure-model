ianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-23T03:08:30Z", "updated_at": "2023-08-23T03:08:30Z", "body": "Alright, let me try to reproduce.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689207919/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689251768", "html_url": "https://github.com/mavlink/MAVSDK/issues/2119#issuecomment-1689251768", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2119", "id": 1689251768, "node_id": "IC_kwDOBabE0s5kr--4", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-23T04:10:36Z", "updated_at": "2023-08-23T04:10:36Z", "body": "Ok, I tried orbit and this worked for me:\r\n\r\n```\r\ndiff --git a/examples/takeoff_and_land/takeoff_and_land.cpp b/examples/takeoff_and_land/takeoff_and_land.cpp\r\nindex 598a3329..b4d01325 100644\r\n--- a/examples/takeoff_and_land/takeoff_and_land.cpp\r\n+++ b/examples/takeoff_and_land/takeoff_and_land.cpp\r\n@@ -89,6 +89,12 @@ int main(int argc, char** argv)\r\n     // Let it hover for a bit before landing again.\r\n     sleep_for(seconds(10));\r\n \r\n+    auto orbit_res = action.do_orbit(10, 5, Action::OrbitYawBehavior::HoldFrontToCircleCenter, 47.3977977, 8.5469410, 500);\r\n+    std::cout << \"Orbit_Res: \" << orbit_res << std::endl;\r\n+    if(orbit_res == mavsdk::Action::Result::Success){\r\n+        sleep_for(seconds(60));\r\n+    }\r\n+\r\n     std::cout << \"Landing...\\n\";\r\n     const Action::Result land_result = action.land();\r\n     if (land_result != Action::Result::Success) {\r\n```\r\n\r\nCan you try that? I'm testing with Gazebo Classic but that shouldn't make a difference. And I'm on the PX4 branch `release/1.14`.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689251768/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689578117", "html_url": "https://github.com/mavlink/MAVSDK/issues/2119#issuecomment-1689578117", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2119", "id": 1689578117, "node_id": "IC_kwDOBabE0s5ktOqF", "user": {"login": "SebastianRosewick", "id": 102235873, "node_id": "U_kgDOBhf-4Q", "avatar_url": "https://avatars.githubusercontent.com/u/102235873?v=4", "gravatar_id": "", "url": "https://api.github.com/users/SebastianRosewick", "html_url": "https://github.com/SebastianRosewick", "followers_url": "https://api.github.com/users/SebastianRosewic