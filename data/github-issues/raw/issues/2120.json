mavlink/MAVSDK/issues/comments/1689210303/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689280364", "html_url": "https://github.com/mavlink/MAVSDK/issues/2120#issuecomment-1689280364", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2120", "id": 1689280364, "node_id": "IC_kwDOBabE0s5ksF9s", "user": {"login": "jperez-droneup", "id": 111766533, "node_id": "U_kgDOBqlsBQ", "avatar_url": "https://avatars.githubusercontent.com/u/111766533?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jperez-droneup", "html_url": "https://github.com/jperez-droneup", "followers_url": "https://api.github.com/users/jperez-droneup/followers", "following_url": "https://api.github.com/users/jperez-droneup/following{/other_user}", "gists_url": "https://api.github.com/users/jperez-droneup/gists{/gist_id}", "starred_url": "https://api.github.com/users/jperez-droneup/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jperez-droneup/subscriptions", "organizations_url": "https://api.github.com/users/jperez-droneup/orgs", "repos_url": "https://api.github.com/users/jperez-droneup/repos", "events_url": "https://api.github.com/users/jperez-droneup/events{/privacy}", "received_events_url": "https://api.github.com/users/jperez-droneup/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-08-23T04:55:13Z", "updated_at": "2023-08-23T04:55:13Z", "body": "We are using MAVSDK at SHA `5d47278251276aea059602d68434547cf9e6d1ff`, but it looks like this is still the case on trunk. \r\n\r\nI am able to reproduce just by calling `mavsdk::Camera::subscribe_mode`, which eventually calls the `make_command_request_camera_settings` linked above. \r\nhttps://github.com/mavlink/MAVSDK/blob/84eab2d996040b6cb839f062f02d072e8723807e/src/mavsdk/plugins/camera/include/plugins/camera/camera.h#L663\r\n\r\nAccording to https://mavlink.io/en/messages/common.html#MAV_CMD_REQUEST_CAMERA_SETTINGS, https://mavlink.io/en/messages/common.html#MAV_CMD_REQUEST_VIDEO_STREAM_INFORMATION, and https://mavlink.io/en/messages/common.html#MAV_CMD_REQUEST_VIDEO_STREAM_STATUS, these messages are deprecated and should be replaced with https://mavlink.io/en/messages/common.html#MAV_CMD_REQUEST_MESSAGE. \r\n\r\nWe are running PX4 sitl gazebo version v1.13.3.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1689280364/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1690782679", "html_url": "https://github.com/mavlink/MAVSDK/issues/2120#issuecomment-1690782679", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2120", "id": 1690782679, "node_id": "IC_kwDOBabE0s5kx0vX", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https