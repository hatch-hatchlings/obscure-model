49:20Z", "updated_at": "2023-09-12T05:33:40Z", "closed_at": "2023-09-12T05:32:28Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "Hi Guys,\r\n\r\nI have a question, which is more C++ related than MAVSDK related, but maybe you will still help me.\r\nI have a ROS2 node-class in which a method is executed based on a timer with a specific frequency. I now want to command a mission, using the MAVSDK-Mission plugin inside this callback-method and want to start the mission in one cycle and track the progress of the mission in every cycle of the callback-method. For that i checked the fly_mission.cpp in the MAVSDK 1.4.10 examples-code and adapted it. For that i need to define the `mission`-variable as a member variable of the ROS2-Node class, but i struggle with it, since its type is deduced with `auto`.  I tried to set the type of mission with something like this `std::shared_ptr<mavsdk::Mission> mission;` but i cant assign it to the instantiation of the Mission-class without compiler error. Maybe you can tell me, if it is possible to save the mission-variable as a class memeber variable and tell me the type, that would help me alot. Sorry for the nooby-question :D   \r\n(From fly_mission.cpp example):\r\n```\r\n    auto action = Action{system};\r\n    auto mission = Mission{system};\r\n    auto telemetry = Telemetry{system};\r\n```\r\nGreetings, Tobias", "closed_by": {"login": "expeditionengineer", "id": 112894063, "node_id": "U_kgDOBrqgbw", "avatar_url": "https://avatars.githubusercontent.com/u/112894063?v=4", "gravatar_id": "", "url": "https://api.github.com/users/expeditionengineer", "html_url": "https://github.com/expeditionengineer", "followers_url": "https://api.github.com/users/expeditionengineer/followers"