ithubusercontent.com/u/67074795?v=4", "gravatar_id": "", "url": "https://api.github.com/users/PavelGuzenfeld", "html_url": "https://github.com/PavelGuzenfeld", "followers_url": "https://api.github.com/users/PavelGuzenfeld/followers", "following_url": "https://api.github.com/users/PavelGuzenfeld/following{/other_user}", "gists_url": "https://api.github.com/users/PavelGuzenfeld/gists{/gist_id}", "starred_url": "https://api.github.com/users/PavelGuzenfeld/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/PavelGuzenfeld/subscriptions", "organizations_url": "https://api.github.com/users/PavelGuzenfeld/orgs", "repos_url": "https://api.github.com/users/PavelGuzenfeld/repos", "events_url": "https://api.github.com/users/PavelGuzenfeld/events{/privacy}", "received_events_url": "https://api.github.com/users/PavelGuzenfeld/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-30T20:18:41Z", "updated_at": "2026-03-30T20:18:41Z", "body": "Both root causes appear to be fixed: the segfault in takeoff_async_apm was fixed in PR #2212, and the missing ArduPlane flight mode mappings were fixed in PR #2676. Can this be closed?", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4157919228/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 1, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4159202815", "html_url": "https://github.com/mavlink/MAVSDK/issues/2152#issuecomment-4159202815", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2152", "id": 4159202815, "node_id": "IC_kwDOBabE0s736GX_", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https