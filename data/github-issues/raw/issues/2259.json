//api.github.com/repos/mavlink/MAVSDK/issues/comments/2024009243/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "YuZhe-CN", "id": 58207455, "node_id": "MDQ6VXNlcjU4MjA3NDU1", "avatar_url": "https://avatars.githubusercontent.com/u/58207455?v=4", "gravatar_id": "", "url": "https://api.github.com/users/YuZhe-CN", "html_url": "https://github.com/YuZhe-CN", "followers_url": "https://api.github.com/users/YuZhe-CN/followers", "following_url": "https://api.github.com/users/YuZhe-CN/following{/other_user}", "gists_url": "https://api.github.com/users/YuZhe-CN/gists{/gist_id}", "starred_url": "https://api.github.com/users/YuZhe-CN/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/YuZhe-CN/subscriptions", "organizations_url": "https://api.github.com/users/YuZhe-CN/orgs", "repos_url": "https://api.github.com/users/YuZhe-CN/repos", "events_url": "https://api.github.com/users/YuZhe-CN/events{/privacy}", "received_events_url": "https://api.github.com/users/YuZhe-CN/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2024049372", "html_url": "https://github.com/mavlink/MAVSDK/issues/2259#issuecomment-2024049372", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2259", "id": 2024049372, "node_id": "IC_kwDOBabE0s54pIrc", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-03-27T21:48:32Z", "updated_at": "2024-03-27T21:48:32Z", "body": "It sounds like to me that you need to:\r\n1. Listen on a default port, e.g. 14550 for drones to appear.\r\n2. Once a drone is connected, you would reconfigure it to another port using some sort of mechanism that you have to implement\r\n3. Then the drone will switch to that other port, leaving 14550 free again for the next one.\r\n\r\nIt would basically be some sort of discovery mechanism on UDP.\r\n\r\nYou could read this to learn how zeromq discovery does it:\r\nhttps://zguide.zeromq.org/docs/chapter8/", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2024049372/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/j