s/YuZhe-CN/orgs", "repos_url": "https://api.github.com/users/YuZhe-CN/repos", "events_url": "https://api.github.com/users/YuZhe-CN/events{/privacy}", "received_events_url": "https://api.github.com/users/YuZhe-CN/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-03-29T20:25:50Z", "updated_at": "2024-03-29T20:26:31Z", "body": "Jajajaja because I'm used to and do not have much practice with cmake. But I finally managed to resolve it. It is because the mavsdk library stored in /usr/lib is named like libmavsdk.so.VERSION. And the linker needs that the name to be libmavsdk.so only. So I created a symbolic link to the library and now It is all fine. \r\n\r\nThank you.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2027703902/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2025805864", "html_url": "https://github.com/mavlink/MAVSDK/issues/2265#issuecomment-2025805864", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2265", "id": 2025805864, "node_id": "IC_kwDOBabE0s54v1go", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Jona