DK/issues/comments/2027703902", "html_url": "https://github.com/mavlink/MAVSDK/issues/2265#issuecomment-2027703902", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2265", "id": 2027703902, "node_id": "IC_kwDOBabE0s543E5e", "user": {"login": "YuZhe-CN", "id": 58207455, "node_id": "MDQ6VXNlcjU4MjA3NDU1", "avatar_url": "https://avatars.githubusercontent.com/u/58207455?v=4", "gravatar_id": "", "url": "https://api.github.com/users/YuZhe-CN", "html_url": "https://github.com/YuZhe-CN", "followers_url": "https://api.github.com/users/YuZhe-CN/followers", "following_url": "https://api.github.com/users/YuZhe-CN/following{/other_user}", "gists_url": "https://api.github.com/users/YuZhe-CN/gists{/gist_id}", "starred_url": "https://api.github.com/users/YuZhe-CN/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/YuZhe-CN/subscriptions", "organizations_url": "https://api.github.com/users/YuZhe-CN/orgs", "repos_url": "https://api.github.com/users/YuZhe-CN/repos", "events_url": "https://api.github.com/users/YuZhe-CN/events{/privacy}", "received_events_url": "https://api.github.com/users/YuZhe-CN/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-03-29T20:25:50Z", "updated_at": "2024-03-29T20:26:31Z", "body": "Jajajaja because I'm used to and do not have much practice with cmake. But I finally managed to resolve it. It is because the mavsdk library stored in /usr/lib is named like libmavsdk.so.VERSION. And the linker needs that the name to be libmavsdk.so only. So I created a symbolic link to the library and now It is all fine. \r\n\r\nThank you.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2027703902/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"lo