 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK-Java/issues/176/timeline", "performed_via_github_app": null, "state_reason": null, "pinned_comment": null}}, "event": "cross-referenced"}], "fetched_at": "2026-08-28T20:39:24Z"}