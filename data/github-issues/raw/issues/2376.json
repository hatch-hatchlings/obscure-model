ists_url": "https://api.github.com/users/KarthiAru/gists{/gist_id}", "starred_url": "https://api.github.com/users/KarthiAru/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/KarthiAru/subscriptions", "organizations_url": "https://api.github.com/users/KarthiAru/orgs", "repos_url": "https://api.github.com/users/KarthiAru/repos", "events_url": "https://api.github.com/users/KarthiAru/events{/privacy}", "received_events_url": "https://api.github.com/users/KarthiAru/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-08-18T11:08:53Z", "updated_at": "2024-08-18T11:08:53Z", "body": "I reviewed the [action plugin implementation](https://github.com/mavlink/MAVSDK/blob/main/src/mavsdk/plugins/action/action_impl.cpp#L331) and found that it uses the MAVLink command [MAV_CMD_DO_FLIGHTTERMINATION](https://mavlink.io/en/messages/common.html#MAV_CMD_DO_FLIGHTTERMINATION). However, I am unsure how to proceed with troubleshooting this issue further.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295222028/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295266638", "html_url": "https://github.com/mavlink/MAVSDK/issues/2376#issuecomment-2295266638", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2376", "id": 2295266638, "node_id": "IC_kwDOBabE0s6Izv1O", "user": {"login": "KarthiAru", "id": 8588253, "node_id": "MDQ6VXNlcjg1ODgyNTM=", "avatar_url": "https://avatars.githubusercontent.com/u/8588253?v=4", "gravatar_id": "", "url": "https://api.github.com/users/KarthiAru", "html_url": "https://github.com/KarthiAru", "followers_url": "https://api.github.com/users/KarthiAru/followers", "following_url": "https://api.github.com/users/KarthiAru/following{/other_user}", "gists_url": "https://api.github.com/users/KarthiAru/gists{/gist_id}", "starred_url": "https://api.github.com/users/KarthiAru/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/KarthiAru/subscriptions", "organizations_url": "https://api.github.com/users/KarthiAru/orgs", "repos_url": "https://api.github.com/users/KarthiAru/repos", "events_url": "https://api.github.com/users/KarthiAru/events{/privacy}", "received_events_url": "https://api.github.com/users/KarthiAru/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-08-18T13:37:47Z", "updated_at": "2024-08-18T13:37:47Z", "body": "I tried terminating in the middle of a mission. It transitioned to an unknown flight mode in QGC.\r\n\r\n![image](https://github.com/user-attachments/assets/d190f197-d297-4054-89b9-de2b0086faad)\r\n\r\nLog: [https://review.px4.io/plot_app?log=978520ae-5dcb-47c2-b182-3361e679d96f](https://review.px4.io/plot_app?log=978520ae-5dcb-47c2-b182-3361e679d96f)", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295266638/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295407557", "html_url": "https://github.com/mavlink/MAVSDK/issues/2376#issuecomment-2295407557", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2376", "id": 2295407557, "node_id": "IC_kwDOBabE0s6I0SPF", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-08-18T21:50:16Z", "updated_at": "2024-08-18T21:50:16Z", "body": "> an error message related to a poll timeout\r\n\r\nI believe this is a SITL problem. The issue is that all actuator outputs are stopped, and so the lockstep simulation is hanging, because there are no more outputs being published. You could argue that it is working as intended but termination is presumably not correctly implemented in SITL.\r\n\r\nYou could try without lockstep, see: https://docs.px4.io/main/en/simulation/#disable-lockstep-simulation", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295407557/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2295649825", "html_url": "https://github.com/mavlink/MAVSDK/issues/2376#issuecomment-2295649825", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2376", "id": 2295649825, "node_id": "IC_kwDOBabE0s6I1NYh", "user": {"login": "KarthiAru", "id": 8588253, "node_id": "MDQ6VXNlcjg1ODgyNTM=", "avatar_url": "https://avatars.githubusercontent.com/u/8588253?v=4", "gravatar_id": "", "u