contributors", "subscribers_url": "https://api.github.com/repos/mavlink/MAVSDK/subscribers", "subscription_url": "https://api.github.com/repos/mavlink/MAVSDK/subscription", "commits_url": "https://api.github.com/repos/mavlink/MAVSDK/commits{/sha}", "git_commits_url": "https://api.github.com/repos/mavlink/MAVSDK/git/commits{/sha}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/comments{/number}", "issue_comment_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments{/number}", "contents_url": "https://api.github.com/repos/mavlink/MAVSDK/contents/{+path}", "compare_url": "https://api.github.com/repos/mavlink/MAVSDK/compare/{base}...{head}", "merges_url": "https://api.github.com/repos/mavlink/MAVSDK/merges", "archive_url": "https://api.github.com/repos/mavlink/MAVSDK/{archive_format}{/ref}", "downloads_url": "https://api.github.com/repos/mavlink/MAVSDK/downloads", "issues_url": "https://api.github.com/repos/mavlink/MAVSDK/issues{/number}", "pulls_url": "https://api.github.com/repos/mavlink/MAVSDK/pulls{/number}", "milestones_url": "https://api.github.com/repos/mavlink/MAVSDK/milestones{/number}", "notifications_url": "https://api.github.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/2801", "html_url": "https://github.com/mavlink/MAVSDK/pull/2801", "diff_url": "https://github.com/mavlink/MAVSDK/pull/2801.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/2801.patch", "merged_at": "2026-03-29T19:56:02Z"}, "body": "## Summary\n- Add `timestamp_us` (uint64) field to `Altitude` and `GroundTruth` telemetry structs\n- Populate from underlying MAVLink messages (`ALTITUDE.time_usec`, `HIL_STATE_QUATERNION.time_usec`)\n- Add system tests verifying end-to-end timestamp propagation via `MavlinkDirect`\n\n## Motivation\nFixes #2391 \u2014 `Altitude` and `GroundTruth` telemetry messages are populated from MAVLink messages that include a `time_usec` field, but MAVSDK was dropping that timestamp when constructing its own structs. This matters for time-series analysis and log correlation.\n\n## Changes\n- **Proto**: Add `timestamp_us` to `Altitude` and `GroundTruth` in telemetry.proto, `GroundTruth` in telemetry_server.proto\n- **Impl**: Populate `timestamp_us` in `process_altitude()` and `process_ground_truth()` \n- **Operators**: Update equality and stream operators for both Telemetry and TelemetryServer\n- **gRPC**: Update `translateToRpc`/`translateFromRpc` for both services\n- **Tests**: 2 new system tests (`AltitudeTimestamp`, `GroundTruthTimestamp`)\n\n## Companion PR\nProto changes: https://github.com/mavlink/MAVSDK-Proto/pull/398\n\n## Test plan\n- [x] Unit tests pass (289/289, same pre-existing `Mavsdk.version` failure)\n- [x] System tests `AltitudeTimestamp` and `GroundTruthTimestamp` pass\n- [x] Build clean with no warnings", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2801/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2801/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"id": 24012084712, "node_id": "CE_lADOBabE0s6VNBiGzwAAAAWXO1Xo", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/24012084712", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "event": "closed", "commit_id": "84f868afb600d7d6c660928ef3bab1bc8c31e41d", "c