0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2492350828", "html_url": "https://github.com/mavlink/MAVSDK/issues/2445#issuecomment-2492350828", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2445", "id": 2492350828, "node_id": "IC_kwDOBabE0s6UjkFs", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-11-21T21:14:58Z", "updated_at": "2024-11-21T21:14:58Z", "body": "Ok, and what message is used to send that button? Presumably it's [MANUAL_CONTROL](https://mavlink.io/en/messages/common.html#MANUAL_CONTROL)?\r\n\r\nIn that case, I wonder if PX4 emits something to signal that a button has been pressed, presumably not, and you have to \"intercept\" this message in MAVSDK.\r\n\r\nAre you using MAVSDK in C++? In that case you can intercept messages manually:\r\nhttps://github.com/mavlink/MAVSDK/blob/v2.12/src/mavsdk/core/include/mavsdk/mavsdk.h#L408-L420", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2492350828/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2494134931", "html_url": "https://github.com/mavlink/MAVSDK/issues/2445#issuecomment-2494134931", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2445", "id": 2494134931, "node_id": "IC_kwDOBabE0s6UqXqT", "user": {"login": "jonazti07", "id": 171661553, "node_id": "U_kgDOCjtY8Q", "avatar_url": "https://avatars.githubusercontent.com/u/171661553?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jonazti07", "html_url": "https://github.com/jonazti07", "followers_url": "https://api.github.com/users/jonazti07/followers", "following_url": "https://api.github.com/users/jonazti07/following{/other_user}", "gists_url": "https://api.github.com/users/jonazti07/gists{/gist_id}", "starred_url": "https://api.github.com/users/jonazti07/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jonazti07/subscriptions", "organizations_url": "https://api.github.com/users/jonazti07/orgs", "repos_url": "https://api.github.com/users/jonazti07/repos", "events_url": "https://api.github.com/users/jonazti07/events{/privacy}", "received_events_url": "https://api.github.com/users/jonazti07/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-11-22T16:18:08Z", "updated_at": "2024-11-22T16:18:08Z", "body": "I think there has been a misunderstanding. I'm not sending myself the buttons states, but I want to receive them.\r\nYes, I'm ussing MAVSDK in C++, but I think this funcitonality is not currently supported, so I'll need to detect this flag in another way in my program.\r\nThanks!", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2494134931/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2496483135", "html_url": "https://github.com/mavlink/MAVSDK/issues/2445#issuecomment-2496483135", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2445", "id": 2496483135, "node_id": "IC_kwDOBabE0s6UzU8_", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-11-25T01:12:41Z", "updated_at": "2024-11-25T01:12:41Z", "body": "So what you're saying is that you're not sending MAVLink RC to PX4, so there is no way for MAVSDK to intercept that message. In that case you have to make sure PX4 sends out [RC_CHANNELS](https://mavlink.io/en/messages/common.html#RC_CHANNELS) and than subscribe to this one in MavlinkPassthrough.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2496483135/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2497528708", "html_url": "https://github.com/mavlink/MAVSDK/issues/2445#issuecomment-2497528708", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2445", "id": 2497528708, "node_id": "IC_kwDOBabE0s6U3UOE", "user": {"login": "jonazti07", "id": 171661553, "node_id": "U_kgDOCjtY8Q", "avatar_url": "https://avatars.githubusercontent.com/u/171661553?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jonazti07", "html_url": "https://github.com/jonazti07", "followers_url": "https://api.github.com/users/jonazti07/followers", "following_url": "https://api.github.com/users/jonazti07/following{/other_user}", "gists_url": "https://api.github.com/users/jonazti07/gists{/gist_id}", "starred_url": "https://api.github.com/users/jonazti07/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jonazti07/subscriptions", "organizations_url": "https://api.github.com/users/jonazti07/orgs", "repos_url": "https://api.github.com/users/jonazti07/repos", "events_url": "https://api.github.com/users/jonazti07/events{/privacy}", "received_events_url": "https://api.github.com/users/jonazti07/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-11-25T10:14:49Z", "updated_at": "2024-11-25T10:14:49Z", "body": "Okay, I see. Thanks for your support.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2497528708/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2499051507", 