following_url": "https://api.github.com/users/Kareem3807/following{/other_user}", "gists_url": "https://api.github.com/users/Kareem3807/gists{/gist_id}", "starred_url": "https://api.github.com/users/Kareem3807/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Kareem3807/subscriptions", "organizations_url": "https://api.github.com/users/Kareem3807/orgs", "repos_url": "https://api.github.com/users/Kareem3807/repos", "events_url": "https://api.github.com/users/Kareem3807/events{/privacy}", "received_events_url": "https://api.github.com/users/Kareem3807/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-12-02T23:29:19Z", "updated_at": "2024-12-02T23:29:19Z", "body": "I'm using Vscode and just compiling the file like so:\r\n\r\ng++ -arch arm64 -std=c++17 Mavlink.cpp ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2513190035/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "Kareem3807", "id": 139641599, "node_id": "U_kgDOCFLC_w", "avatar_url": "https://avatars.githubusercontent.com/u/139641599?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Kareem3807", "html_url": "https://github.com/Kareem3807", "followers_url": "https://api.github.com/users/Kareem3807/followers", "following_url": "https://api.github.com/users/Kareem3807/following{/other_user}", "gists_url": "https://api.github.com/users/Kareem3807/gists{/gist_id}", "starred_url": "https://api.github.com/users/Kareem3807/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Kareem3807/subscriptions", "organizations_url": "https://api.github.com/users/Kareem3807/orgs", "repos_url": "https://api.github.com/users/Kareem3807/repos", "events_url": "https://api.github.com/users/Kareem3807/events{/privacy}", "received_events_url": "https://api.github.com/users/Kareem3807/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2513680817", "html_url": "https://github.com/mavlink/MAVSDK/issues/2456#issuecomment-2513680817", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2456", "id": 2513680817, "node_id": "IC_kwDOBabE0s6V07mx", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-12-03T06:38:25Z", "updated_at": "2024-12-03T06:38:25Z", "body": "Ok, when you compile C++, you need to learn how to set include directories (so it finds the includes) and link to libraries. That's a general C++ concept, and nothing MAVSDK specific.\r\n\r\nMAVSDK tries to be like any other library, and supports specifically cmake (and its find_package).\r\n\r\nBest to just look at how examples are built, e.g.:\r\nhttps://github.com/mavlink/MAVSDK/blob/main/examples/gimbal/CMakeLists.txt\r\n\r\nThere is also some documentation for this:\r\nhttps://mavsdk.mavlink.io/main/en/cpp/guide/toolchain.html#build-definition-file---cmakeliststxt\r\n\r\nUnfortunately, it's out of date, so linking to the plugins is no longer needed, so:\r\n\r\n```\r\ntarget_link_libraries(your_executable_name\r\n    MAVSDK::mavsdk             # needed!\r\n    MAVSDK::mavsdk_action      # not needed, remove this!\r\n)\r\n\r\n```", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2513680817/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"id": 15504247091, "node_id": "CE_lADOBabE0s6huncVzwAAAAOcIAkz", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/15504247091", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.gi