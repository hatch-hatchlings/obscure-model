/gists{/gist_id}", "starred_url": "https://api.github.com/users/liuchuanping/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/liuchuanping/subscriptions", "organizations_url": "https://api.github.com/users/liuchuanping/orgs", "repos_url": "https://api.github.com/users/liuchuanping/repos", "events_url": "https://api.github.com/users/liuchuanping/events{/privacy}", "received_events_url": "https://api.github.com/users/liuchuanping/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2560581303", "html_url": "https://github.com/mavlink/MAVSDK/issues/2483#issuecomment-2560581303", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2483", "id": 2560581303, "node_id": "IC_kwDOBabE0s6Yn163", "user": {"login": "liuchuanping", "id": 33689986, "node_id": "MDQ6VXNlcjMzNjg5OTg2", "avatar_url": "https://avatars.githubusercontent.com/u/33689986?v=4", "gravatar_id": "", "url": "https://api.github.com/users/liuchuanping", "html_url": "https://github.com/liuchuanping", "followers_url": "https://api.github.com/users/liuchuanping/followers", "following_url": "https://api.github.com/users/liuchuanping/following{/other_user}", "gists_url": "https://api.github.com/users/liuchuanping/gists{/gist_id}", "starred_url": "https://api.github.com/users/liuchuanping/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/liuchuanping/subscriptions", "organizations_url": "https://api.github.com/users/liuchuanping/orgs", "repos_url": "https://api.github.com/users/liuchuanping/repos", "events_url": "https://api.github.com/users/liuchuanping/events{/privacy}", "received_events_url": "https://api.github.com/users/liuchuanping/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-12-24T03:11:09Z", "updated_at": "2024-12-24T03:11:09Z", "body": "I used MAVSDK to communicate with a flying module device mounted on a drone. This module device is a product I bought from a drone flight control hardware manufacturer. The manufacturer said that the module supports the MAVLink protocol, and I successfully simulated it using their own ground station and non air and simulation equipment. However, when I connected their flight control to MAVSDK, there was a problem. The exception message is as follows: Error] Retrying failed for REQUEST_MESSAGE command for message: 148, to (50/1) (mavlink_command_sender.cpp:361)\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2560581303/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "liuchuanping", "id": 33689986, "node_id": "MDQ6VXNlcjMzNjg5OTg2", "avatar_url": "https://avatars.githubusercontent.com/u/33689986?v=4", "gravatar_id": "", "url": "https://api.github.com/users/liuchuanping", "html_url": "https://github.com/liuchuanping", "followers_url": "https://api.github.com/users/liuchuanping/followers", "following_url": "https://api.github.com/users/liuchuanping/following{/other_user}", "gists_url": "https://api.github.com/users/liuchuanping/gists{/gist_id}", "starred_url": "https://api.github.com/users/liuchuanping/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/liuchuanping/subscriptions", "organizations_url": "https://api.github.com/users/liuchuanping/orgs", "repos_url": "https://api.github.com/users/liuchuanping/repos", "events_url": "https://api.github.com/users/liuchuanping/events{/privacy}", "received_events_url": "https://api.github.com/users/liuchuanping/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2563949214", "html_url": "https://github.com/mavlink/MAVSDK/issues/2483#issuecomment-2563949214", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2483", "id": 2563949214, "node_id": "IC_kwDOBabE0s6Y0sKe", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2024-12-27T18:49:16Z", "updated_at": "2024-12-27T18:49:16Z", "body": "Message 148 is [AUTOPILOT_VERSION](https://mavlink.io/en/messages/common.html#AUTOPILOT_VERSION).\r\n\r\nIt sounds like this module is implementing MAVLink but might not be implementing the REQUEST_MESSAGE command yet.\r\n\r\nIs this module \"faking\" to be a drone?\r\n\r\nOn the MAVSDK side, we probably have to fall back to the old command which is [MAV_CMD_REQUEST_AUTOPILOT_CAPABILITIES](https://mavlink.io/en/messages/common.html#MAV_CMD_REQUEST_AUTOPILOT_CAPABILITIES). That might help. I can try that some time.\r\n\r\nDoes it work at all, or not? I suspect not because it doesn't see an autopilot unless it gets that message.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2563949214/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2614114521", "html_url": "https://github.com/mavlink/MAVSDK/issues/2483#issuecomment-2614114521", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2483", "id": 2614114521, "node_id": "IC_kwDOBabE0s6b0DjZ", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}",