sues/comments/2669731683", "html_url": "https://github.com/mavlink/MAVSDK/issues/2515#issuecomment-2669731683", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2515", "id": 2669731683, "node_id": "IC_kwDOBabE0s6fIN9j", "user": {"login": "jnomikos", "id": 84941452, "node_id": "MDQ6VXNlcjg0OTQxNDUy", "avatar_url": "https://avatars.githubusercontent.com/u/84941452?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jnomikos", "html_url": "https://github.com/jnomikos", "followers_url": "https://api.github.com/users/jnomikos/followers", "following_url": "https://api.github.com/users/jnomikos/following{/other_user}", "gists_url": "https://api.github.com/users/jnomikos/gists{/gist_id}", "starred_url": "https://api.github.com/users/jnomikos/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jnomikos/subscriptions", "organizations_url": "https://api.github.com/users/jnomikos/orgs", "repos_url": "https://api.github.com/users/jnomikos/repos", "events_url": "https://api.github.com/users/jnomikos/events{/privacy}", "received_events_url": "https://api.github.com/users/jnomikos/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-02-19T20:51:08Z", "updated_at": "2025-02-19T20:54:04Z", "body": "tl;dr\n\nRebooting via MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN does not actually make the system disconnect, which is fine, except telemetry subscriptions become stale. I do not know of a way to check if the system has rebooted, because the system stays connected. ", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2669731683/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "jnomikos", "id": 84941452, "node_id": "MDQ6VXNlcjg0OTQxNDUy", "avatar_url": "https://avatars.githubusercontent.com/u/84941452?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jnomikos", "html_url": "https://github.com/jnomikos", "followers_url": "https://api.github.com/users/jnomikos/followers", "following_url": "https://api.github.com/users/jnomikos/following{/other_user}", "gists_url": "https://api.github.com/users/jnomikos/gists{/gist_id}", "starred_url": "https://api.github.com/users/jnomikos/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jnomikos/subscriptions", "organizations_url": "https://api.github.com/users/jnomikos/orgs", "repos_url": "https://api.github.com/users/jnomikos/repos", "events_url": "https://api.github.com/users/jnomikos/events{/privacy}", "received_events_url": "https://api.github.com/users/jnomikos/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2669834948", "html_url": "https://github.com/mavlink/MAVSDK/issues/2515#issuecomment-2669834948", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2515", "id": 2669834948, "node_id": "IC_kwDOBabE0s6fInLE", "user": {"login": "jnomikos", "id": 84941452, "node_id": "MDQ6VXNlcjg0OTQxNDUy", "avatar_url": "https://avatars.githubusercontent.com/u/84941452?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jnomikos", "html_url": "https://github.com/jnomikos", "followers_url": "https://api.github.com/users/jnomikos/followers", "following_url": "https://api.github.com/users/jnomikos/following{/other_user}", "gists_url": "https://api.github.com/users/jnomikos/gists{/gist_id}", "starred_url": "https://api.github.com/users/jnomikos/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jnomikos/subscriptions", "organizations_url": "https://api.github.com/users/jnomikos/orgs", "repos_url": "https://api.github.com/users/jnomikos/repos", "events_url": "https://api.github.com/users/jnomikos/events{/privacy}", "received_events_url": "https://api.github.com/users/jnomikos/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-02-19T21:47:38Z", "updated_at": "2025-02-19T21:54:47Z", "body": "My idea of a solution of listening for MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN did not work, likely due to the system rebooting before the message gets forwarded.\n\nNext idea of a solution is to actively track the time since we last received a telemetry position message. If above a threshold value, we stop/start telemetry\n\nEdit: For my particular use case, this worked\n\nSomewhere in my class I have this. (I plan on refactoring this, but it's just proof of concept). I'm going to probably put this on a different thread\n\n```\n    while(true) {\n        std::chrono::steady_clock::time_point currentTime = std::chrono::steady_clock::now();\n        if(std::chrono::duration_cast<std::chrono::seconds>(currentTime - last_position_time).count() > 5) {\n            std::cout << \"No position updates for 5 seconds.\" << std::endl;\n            // Destroy current telemetry object\n            telemetry.reset();\n\n            // Restart telemetry\n            mavsdk_telemetry_init();\n        }\n        std::this_thread::sleep_for(std::chrono::seconds(1));\n    }\n```\n\nIn my class, I have this private variable\n```\nstd::chrono::steady_clock::time_point last_position_time;\n```\n\nIn subscribe position:\n```\ntelemetry->subscribe_position([this](mavsdk::Telemetry::Position position) {\n        std::cout << \"Position: \" << std::fixed << std::setprecision(6) << position.latitude_deg << \", \" << std::fixed << std::setprecision(6) << position.longitude_deg << \", \" <<\n                  std::fixed << std::setprecision(6) << position.absolute_altitude_m << std::endl;\n\nlast_position_time = std::chrono::steady_clock::now();\n\n       // do stuff here with the data we have\n\n    });\n```\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2669834948/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "jnomikos", "id": 84941452, "node_id": "MDQ6VXNlcjg0OTQxNDUy", "avatar_url": "https://avatars.githubusercontent.com/u/84941452?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jnomikos", "html_url": "https://github.com/jnomikos", "followers_url": "https://api.github.com/users/jnomikos/followers", "following_url": "https://api.github.com/users/jnomikos/following{/other_user}", "gists_url": "https://api.github.com/users/jnomikos/gists{/gist_id}", "starred_url": "https://api.github.com/users/jnomikos/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jnomikos/subscriptions", "organizations_url": "https://api.github.com/users/jnomikos/orgs", "repos_url": "https://api.github.com/users/jnomikos/repos", "events_url": "https://api.github.com/users/jnomikos/events{/privacy}", "received_events_url": "https://api.github.com/users/jnomikos/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/2670025144", "html_url": "https://github.com/mavlink/MAVSDK/issues/2515#issuecomment-2670025144", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2515", "id": 2670025144, "node_id": "IC_kwDOBabE0s6fJVm4", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "http