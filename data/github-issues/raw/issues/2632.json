ssues/comments/3139074857/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3139105705", "html_url": "https://github.com/mavlink/MAVSDK/issues/2632#issuecomment-3139105705", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2632", "id": 3139105705, "node_id": "IC_kwDOBabE0s67GvOp", "user": {"login": "yuxuanwu1234567", "id": 104252946, "node_id": "U_kgDOBjbGEg", "avatar_url": "https://avatars.githubusercontent.com/u/104252946?v=4", "gravatar_id": "", "url": "https://api.github.com/users/yuxuanwu1234567", "html_url": "https://github.com/yuxuanwu1234567", "followers_url": "https://api.github.com/users/yuxuanwu1234567/followers", "following_url": "https://api.github.com/users/yuxuanwu1234567/following{/other_user}", "gists_url": "https://api.github.com/users/yuxuanwu1234567/gists{/gist_id}", "starred_url": "https://api.github.com/users/yuxuanwu1234567/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/yuxuanwu1234567/subscriptions", "organizations_url": "https://api.github.com/users/yuxuanwu1234567/orgs", "repos_url": "https://api.github.com/users/yuxuanwu1234567/repos", "events_url": "https://api.github.com/users/yuxuanwu1234567/events{/privacy}", "received_events_url": "https://api.github.com/users/yuxuanwu1234567/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-07-31T08:54:51Z", "updated_at": "2025-07-31T08:54:51Z", "body": "> Ok, and what you're looking at here in QGC is that what MAVSDK sends or what the drone sends as telemetry?\n\n\nIt is the data sent by mavsdk.\nauto mocap = Mocap{system.value()};\n        \n        Mocap::VisionPositionEstimate pose{};\n        Eigen::Vector3d enu_position(\n            externalPoseUpdate_cmd.params.x,\n            externalPoseUpdate_cmd.params.y,\n            externalPoseUpdate_cmd.params.z);\n        Eigen::Vector3d ned_position = FMMath::transform_frame_enu_ned(enu_position);\n\n        pose.position_body.x_m = ned_position.x();\n        pose.position_body.y_m = ned_position.y();\n        pose.position_body.z_m = ned_position.z();\n\n        if (externalPoseUpdate_cmd.params.position_only)\n        {   \n            pose.angle_body.roll_rad = 0;\n            pose.angle_body.pitch_rad = 0;\n            pose.angle_body.yaw_rad = 0;\n        }\n        else{\n            Eigen::Quaterniond ros_body_quat(\n                externalPoseUpdate_cmd.params.qw, \n                externalPoseUpdate_cmd.params.qx, \n                externalPoseUpdate_cmd.params.qy, \n                externalPoseUpdate_cmd.params.qz);\n            Eigen::Quaterniond fcu_body_ros_local = FMMath::transform_orientation_baselink_aircraft(ros_body_quat);\n            Eigen::Quaterniond fcu_body_fcu_local = FMMath::transform_orientation_enu_ned(fcu_body_ros_local);\n            Eigen::Vector3d rpy = FMMath::quaternion_to_euler(fcu_body_fcu_local);\n            pose.angle_body.roll_rad = rpy.x();\n            pose.angle_body.pitch_rad = rpy.y();\n            pose.angle_body.yaw_rad = rpy.z();\n        }\n\n        pose.pose_covariance.covariance_matrix.push_back(NAN);\n\n        auto mocap_update_result =  mocap.set_vision_position_estimate(pose);\n        if (mocap_update_result != Mocap::Result::Success)\n        {\n            std::stringstream sstr;\n\n            sstr << \"update mocap pose failed: \" << mocap_update_result;\n            m_logger.warning(sstr.str());\n            return;\n        }", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3139105705/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "yuxuanwu1234567", "id": 104252946, "node_id": "U_kgDOBjbGEg", "avatar_url": "https://avatars.githubusercontent.com/u/104252946?v=4", "gravatar_id": "", "url": "https://api.github.com/users/yuxuanwu1234567", "html_url": "https://github.com/yuxuanwu1234567", "followers_url": "https://api.github.com/users/yuxuanwu1234567/followers", "following_url": "https://api.github.com/users/yuxuanwu1234567/following{/other_user}", "gists_url": "https://api.github.com/users/yuxuanwu1234567/gists{/gist_id}", "starred_url": "https://api.github.com/users/yuxuanwu1234567/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/yuxuanwu1234567/subscriptions", "organizations_url": "https://api.github.com/users/yuxuanwu1234567/orgs", "repos_url": "https://api.github.com/users/yuxuanwu1234567/repos", "events_url": "https://api.github.com/users/yuxuanwu1234567/events{/privacy}", "received_events_url": "https://api.github.com/users/yuxuanwu1234567/received_e