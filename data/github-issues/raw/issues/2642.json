/tranhien1612/events{/privacy}", "received_events_url": "https://api.github.com/users/tranhien1612/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-08-14T02:05:41Z", "updated_at": "2025-08-14T02:05:41Z", "body": "I am not familiar with this, do you have an example for it?", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186477888/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186488315", "html_url": "https://github.com/mavlink/MAVSDK/issues/2642#issuecomment-3186488315", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2642", "id": 3186488315, "node_id": "IC_kwDOBabE0s697fP7", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-08-14T02:08:40Z", "updated_at": "2025-08-14T02:09:08Z", "body": "```\nmavsdk::Mavsdk mavsdk{\n    mavsdk::Mavsdk::Configuration{mavsdk::ComponentType::GroundStation}\n};\n```\n\nYou need to configure this as maybe a `mavsdk::ComponentType::CompanionComputer` instead.\n\nAnd see this example:\n\nhttps://github.com/mavlink/MAVSDK/blob/e5b8bb7bbe71c54d55db5794303031d304c224fe/examples/battery/publish_battery.cpp#L94\n\nAnd you want to keep the MavlinkPassthrough plugin instance created and note create and delete it on each function call.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186488315/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186522526", "html_url": "https://github.com/mavlink/MAVSDK/issues/2642#issuecomment-3186522526", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2642", "id": 3186522526, "node_id": "IC_kwDOBabE0s697nme", "user": {"login": "tranhien1612", "id": 69721832, "node_id": "MDQ6VXNlcjY5NzIxODMy", "avatar_url": "https://avatars.githubusercontent.com/u/69721832?v=4", "gravatar_id": "", "url": "https://api.github.com/users/tranhien1612", "html_url": "https://github.com/tranhien1612", "followers_url": "https://api.github.com/users/tranhien1612/followers", "following_url": "https://api.github.com/users/tranhien1612/following{/other_user}", "gists_url": "https://api.github.com/users/tranhien1612/gists{/gist_id}", "starred_url": "https://api.github.com/users/tranhien1612/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/tranhien1612/subscriptions", "organizations_url": "https://api.github.com/users/tranhien1612/orgs", "repos_url": "https://api.github.com/users/tranhien1612/repos", "events_url": "https://api.github.com/users/tranhien1612/events{/privacy}", "received_events_url": "https://api.github.com/users/tranhien1612/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-08-14T02:16:47Z", "updated_at": "2025-08-14T02:16:47Z", "body": "i tried following your instructions, it doesn't seem to work, i don't see the text message in the `vehicle messages` tab.\n\n```c\n    mavsdk::Mavsdk mavsdk{\n        mavsdk::Mavsdk::Configuration{mavsdk::ComponentType::CompanionComputer} //GroundStation\n    };\n    mavsdk::ConnectionResult connection_result = mavsdk.add_any_connection(\"udpin://0.0.0.0:14550\"); \n\n    while (mavsdk.systems().size() == 0) {\n        std::this_thread::sleep_for(std::chrono::seconds(1));\n    }\n  \n    std::shared_ptr<mavsdk::System> vehicle = mavsdk.systems().at(0);\n\n    auto mavlink_passthrough = mavsdk::MavlinkPassthrough{vehicle};\n    mavlink_passthrough.queue_message([&](MavlinkAddress mavlink_address, uint8_t channel) {\n        mavlink_message_t message;\n        const char *status_text = \"All systems nominal\"; // your status text\n        mavlink_msg_statustext_pack_chan(\n            mavlink_address.system_id,\n            mavlink_address.component_id,\n            channel,\n            &message,\n            MAV_SEVERITY_INFO,      // MAV_SEVERITY\n            status_text,            // text\n            0,                      // id (optional, for chunked messages, usually 0)\n            0                       // chunk_seq (optional, usually 0)\n        );\n\n        return message;\n    });\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186522526/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3186581525", "html_url": "https://github.com/mavlink/MAVSDK/issues/2642#issuecomment-3186581525", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2642", "id": 3186581525, "node_id": "IC_kwDOBabE0s6972AV", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-08-14T02:54:50Z", "updated_at": "2025-08-14T02:54:50Z", "body": "It might only show them coming from 1/1, so you have to fake this:\n```\n            mavlink_address.system_id,\n            mavlink_address.component_id,\n```\n\nwith \n```\n1,\n1\n```\n\ninstead.\n\nOh, and then there is the problem that both MAVSDK and MissionPlanner connect to the drone, right? So you're assuming the drone would forward your message but if the message's source is \"from\" the drone, it might not do that. You will have to think of how the communication path should work.\n\nYou could for instance connect to the drone and MissionPlanner in MAVSDK and forward messages between them.\n\nSee: https://mavsdk.mavlink.io/main/en/cpp/guide/connections.html#forwarding-mavlink-between-connections", "author_association": "COLLABORATOR", "pin": null, "reactions": 