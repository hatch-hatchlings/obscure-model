om/repos/mavlink/MAVSDK/contents/{+path}", "compare_url": "https://api.github.com/repos/mavlink/MAVSDK/compare/{base}...{head}", "merges_url": "https://api.github.com/repos/mavlink/MAVSDK/merges", "archive_url": "https://api.github.com/repos/mavlink/MAVSDK/{archive_format}{/ref}", "downloads_url": "https://api.github.com/repos/mavlink/MAVSDK/downloads", "issues_url": "https://api.github.com/repos/mavlink/MAVSDK/issues{/number}", "pulls_url": "https://api.github.com/repos/mavlink/MAVSDK/pulls{/number}", "milestones_url": "https://api.github.com/repos/mavlink/MAVSDK/milestones{/number}", "notifications_url": "https://api.github.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "body": "This tracks which PRs merged into `main` since the **v3.15.0** tag (2026-02-05, commit `721efdc`) should be backported to the `v3` branch.\n\nThe goal is to get bug fixes and non-breaking feature additions onto `v3` without pulling in the structural changes (C wrapper, Python bindings, repo reorganisation) that are main-only.\n\n---\n\n## \u2705 Backport to v3\n\n### Bug fixes\n\n| PR | Title | Notes |\n|----|-------|-------|\n| #2770 | Fix: empty mission now returns empty | Behaviour fix: download returned 1 empty item instead of 0 |\n| #2771 | Fix: setting current mission item | Crash fix: out-of-range index with no loaded mission |\n| #2776 | Fix MAVSDK destructor | Fixes crashes when stopping from language bindings |\n| #2792 | core: Fix data race in mission transfer WorkItem dtor | TSan use-after-free; switches to `unregister_all_blocking()` |\n| #2797 | camera: fix InProgress status translated as Unknown | One-line enum mapping fix |\n| #2806 | system_tests: fix mission cancellation tests to not hang or race | Includes real `transfer_mutex` fix in `MissionImpl` |\n| #2821 | mission_raw_server: Fix crash on empty mission upload | `back()` on empty vector when count=0; fixes #1962 |\n| #2822 | log_streaming: Guard ardupilotmega-specific messages with #ifdef | Compilation fix for non-ardupilotmega dialects; fixes #2783 |\n| #2827 | mocap: Fix MavFrame enum sending wrong values on the wire | Wrong frame IDs sent; fixes #2001 |\n| #2828 | system_tests: Fix race in mission tests (register server before connections) | Fixes upload rejections; fixes #2702 |\n\n### New features (non-breaking API additions)\n\n| PR | Title | Notes |\n|----|-------|-------|\n| #2769 | core: add `set_callback_executor` API | Lets users supply a custom callback executor |\n| #2801 | Add `timestamp_us` to `Altitude` and `GroundTruth` telemetry | Requires proto PR mavlink/MAVSDK-Proto#398 (already merged) |\n| #2803 | Implement `set_rate_rc` for ArduPilot via `SYS_STATUS` | Was always returning `Unsupported` on ArduPilot |\n| #2804 | Implement `download_geofence` | Mirrors `download_mission`; requires proto PR mavlink/MAVSDK-Proto#400 |\n| #2825 | camera: add xz decompression support for camera definition files | Feature/fix for compressed definition files |\n| #2826 | telemetry: add `set_rate_raw_gps` | Requires proto PR mavlink/MAVSDK-Proto#403 (already merged) |\n\n### Style / code quality\n\n| PR | Title | Notes |\n|----|-------|-------|\n| #2829 | Fixup style in C++, fixup template and whitespace issue in C | Style-only, no logic changes |\n\n### CI / tooling / examples\n\n| PR | Title | Notes |\n|----|-------|-------|\n| #2772 | examples: add speed feedback to logfile_download | |\n| #2805 | CI: update action versions to prevent warnings | |\n| #2816 | test: add FTP upload throughput timing to FtpUploadBigFile | |\n| #2819 | ci: cancel in-progress runs on new PR commits | |\n\n---\n\n## \u274c Skip (main only)\n\n| PR | Title | Reason |\n|----|-------|--------|\n| #2763 | Move to cpp folder | Breaking structural change |\n| #2765 | Docs: Update broken links for new docs location | Specific to new repo structure |\n| #2767 | Add C wrapper to MAVSDK-C++ | New language binding, main only |\n| #2768 | Shell scripts cleanup | Tooling, low value |\n| #2773 | Add mavsdk server docker with compose | Tooling |\n| #2774 | docs: updates regarding cpp directory | New structure docs |\n| #2775 | Add devcontainer | Tooling |\n| #2777 | c: unsubscribe properly before destroy | C wrapper specific |\n| #2778 | deps: bump rollup | Docs JS dependency |\n| #2779 | Run proto check for C wrappers | CI for C wrapper |\n| #2780 | ci: remove coverage check | CI only |\n| #2781 | ci: build cmavsdk with musl | CI for C wrapper |\n| #2784 | ci: add manylinux jobs | CI for C/Python |\n| #2785 | ci: remove manylinux2014-aarch64 workaround | CI only |\n| #2786 | c: add option to bundle static runtime | C wrapper build |\n| #2787 | Add pymavsdk | New Python binding, main only |\n| #2788 | fix: docker compose dockerfile path | Tooling |\n| #2790 | c/py: add raw connection | C/Python binding feature |\n| #2794 | ci: build pymavsdk wheel for macOS | CI for Python |\n| #2796 | ci: build wheel for Windows | CI for Python |\n| #2798 | c: improve cmake install | C wrapper build |\n| #2808 | README: fix logo image path | Specific to new structure |\n| #2809 | README: add MAVSDK-Go, fix docs source link | Docs/README |\n| #2817 | tools: allow build dir to be set | Tooling, low urgency |\n| #2818 | docs: fix dependabot vulnerabilities | Docs dependency |\n| #2831 | docs: Fix dependabot warnings | Docs dependency |\n\n---\n\n## Notes\n\n- The `v3` branch is currently at `721efdc` (= v3.15.0 tag).\n- PRs requiring a proto bump (#2801, #2804, #2826) need the submodule updated alongside the cherry-pick.\n- #2806 and #2828 are listed under system tests but include real production fixes (`transfer_mutex` in MissionImpl, capability advertisement ordering).\n", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2832/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2832/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}}, "event": "cross-referenced"}, {"id": 24094553865, "node_id": "REFE_lADOBabE0s7VtiDZzwAAAAWcJbcJ", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/24094553865", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https: