w_type": "public", "site_admin": false}, "created_at": "2025-12-02T01:55:53Z", "updated_at": "2025-12-02T01:55:53Z", "body": "> I'm not sure I can help with ACFLY I'm afraid. Never heard of this.\n\n\u597d\u5427\uff0c\u8fd9\u662f\u4f7f\u7528mavsdk\u7684\u65b9\u5f0f\uff1a\nMission.MissionPlan missionPlan = new Mission.MissionPlan(missionItems);\n        drone.getMission().uploadMission(missionPlan)\n                .andThen(drone.getMission().startMission())\n                .subscribe(\n                        () -> log.info(\"Mission started successfully\"),\n                        throwable -> log.error(\"Mission start failed: {}\", throwable.getMessage())\n                );\n\n\n\u6211\u60f3\u77e5\u9053\u8fd9\u4e2a\u65b9\u5f0f\u548c\u4f7f\u7528MavlinkDirect\u6267\u884c\u4efb\u52a1\u65b9\u5f0f\u6709\u5565\u533a\u522b\u5462\u3002\u56e0\u4e3a\u4f7f\u7528\u8fd9\u4e2a\u65b9\u5f0f\u62a5\u9519\uff0c\u4f46\u662f\u4f7f\u7528MavlinkDirect\u4e0d\u4f1a\u3002", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3599796889/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "ButyAfter", "id": 83112426, "node_id": "MDQ6VXNlcjgzMTEyNDI2", "avatar_url": "https://avatars.githubusercontent.com/u/83112426?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ButyAfter", "html_url": "https://github.com/ButyAfter", "followers_url": "https://api.github.com/users/ButyAfter/followers", "following_url": "https://api.github.com/users/ButyAfter/following{/other_user}", "gists_url": "https://api.github.com/users/ButyAfter/gists{/gist_id}", "starred_url": "https://api.github.com/users/ButyAfter/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ButyAfter/subscriptions", "organizations_url": "https://api.github.com/users/ButyAfter/orgs", "repos_url": "https://api.github.com/users/ButyAfter/repos", "events_url": "https://api.github.com/users/ButyAfter/events{/privacy}", "received_events_url": "https://api.github.com/users/ButyAfter/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/3600197235", "html_url": "https://github.com/mavlink/MAVSDK/issues/2717#issuecomment-3600197235", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2717", "id": 3600197235, "node_id": "IC_kwDOBabE0s7WlqZz", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2025-12-02T04:59:46Z", "updated_at": "2025-12-02T04:59:46Z", "body": "The mission plugin does the mission transfer implementation for you. It only supports the _INT messages. If your autopilot doesn't set the capability bit correctly, there is not much mavsdk can do.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/360