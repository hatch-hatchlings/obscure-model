{"issue": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2717", "repository_url": "https://api.github.com/repos/mavlink/MAVSDK", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2717/labels{/name}", "comments_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2717/comments", "events_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2717/events", "html_url": "https://github.com/mavlink/MAVSDK/issues/2717", "id": 3661906260, "node_id": "I_kwDOBabE0s7aREFU", "number": 2717, "title": "[03:09:59|Error] Int messages are not supported. (mavlink_mission_transfer_client.cpp:38)", "user": {"login": "ButyAfter", "id": 83112426, "node_id": "MDQ6VXNlcjgzMTEyNDI2", "avatar_url": "https://avatars.githubusercontent.com/u/83112426?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ButyAfter", "html_url": "https://github.com/ButyAfter", "followers_url": "https://api.github.com/users/ButyAfter/followers", "following_url": "https://api.github.com/users/ButyAfter/following{/other_user}", "gists_url": "https://api.github.com/users/ButyAfter/gists{/gist_id}", "starred_url": "https://api.github.com/users/ButyAfter/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ButyAfter/subscriptions", "organizations_url": "https://api.github.com/users/ButyAfter/orgs", "repos_url": "https://api.github.com/users/ButyAfter/repos", "events_url": "https://api.github.com/users/ButyAfter/events{/privacy}", "received_events_url": "https://api.github.com/users/ButyAfter/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 5, "created_at": "2025-11-25T07:57:49Z", "updated_at": "2025-12-02T04:59:46Z", "closed_at": "2025-12-02T04:59:46Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "per