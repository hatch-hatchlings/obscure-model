thub.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/2815", "html_url": "https://github.com/mavlink/MAVSDK/pull/2815", "diff_url": "https://github.com/mavlink/MAVSDK/pull/2815.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/2815.patch", "merged_at": "2026-04-04T03:56:39Z"}, "body": "Closes #2812.\n\n## Summary\n\n- Bump `CMAKE_CXX_STANDARD` from 17 to 20\n- Add **fmtlib 12.1.0** as a PRIVATE third-party dependency (does not leak to consumers or examples)\n- Rewrite `log.h` to use `fmt::format_string<Args...>` + `fmt::format` unconditionally \u2014 no platform fallbacks, no `std::format`\n- Replace all stream-based `LogDebug`/`LogInfo`/`LogWarn`/`LogErr` call sites with format-string style: `LogDebug(\"text {}\", value)`\n- Reduce `std_format.h` to a thin wrapper: `#include <fmt/format.h>` + `#include <fmt/ostream.h>`\n- Add `to_string() -> std::string_view` to all plugin enums so they can be used in log format strings without leaking fmt into public headers\n- Add `to_string()` for `ConnectionResult` for the same reason\n- Use `ParamValue::get_string()` at log call sites instead of streaming the object\n- Remove `#include \"log.h\"` from `c/src/cmavsdk/mavsdk.h` \u2014 the log subscription API is optional and should be included explicitly\n- Update MSVC compiler flags for C++20 (`/utf-8`)\n- Regenerate all plugin files from updated templates\n\n## Why fmtlib instead of std::format\n\n`std::format` is unavailable on iOS before 16.4, and has incomplete floating-point support on some older Android NDKs. fmtlib is the reference implementation, is available on all supported platforms, and is already used by many projects in the ecosystem. It is linked PRIVATELY so it does not affect the public API or consumers' build systems.\n\n## Design decisions\n\n- **fmt is PRIVATE**: linked only to `mavsdk` (and tests), not re-exported via `target_link_libraries PUBLIC`\n- **No fmt in public headers**: enums use `to_string()` returning `std::string_view` (compile-time constant), non-enum types use existing string helpers like `get_string()`\n- **No fallback paths**: `std_format.h` is a simple include shim, not a compatibility layer\n\n## Test plan\n\n- [x] Linux superbuild\n- [x] macOS\n- [x] Windows MSVC\n- [x] Android\n- [x] iOS\n- [x] Fuzzing\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.com/claude-code)", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2815/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2815/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"id": 24191556140, "node_id": "CE_lADOBabE0s73v6qHzwAAAAWh7dos", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/24191556140", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "event": "closed", "commit_id": null, "commit_url": null, "created_at": "2026-04-04T03:56:41Z", "state_reason": null, "intent": null, "performed_via_github_app": null}], "fetched_at": "2026-08-28T20:39:47Z"}