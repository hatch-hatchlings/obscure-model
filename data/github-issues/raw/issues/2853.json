es/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "event": "referenced", "commit_id": "835766d56b8e7ee23329c693d18ef17cf2c7b889", "commit_url": "https://api.github.com/repos/mavlink/MAVSDK/commits/835766d56b8e7ee23329c693d18ef17cf2c7b889", "created_at": "2026-08-09T22:25:32Z", "performed_via_github_app": null}], "fetched_at": "2026-08-28T20:39:48Z"}