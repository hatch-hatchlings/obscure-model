se": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/2881", "html_url": "https://github.com/mavlink/MAVSDK/pull/2881", "diff_url": "https://github.com/mavlink/MAVSDK/pull/2881.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/2881.patch", "merged_at": "2026-05-20T04:36:13Z"}, "body": "The `friend std::ostream& operator<<` for `MavlinkPassthrough::Result` in `mavlink_passthrough.hpp` is missing the `MAVSDK_PUBLIC` visibility specifier, so the symbol is hidden in `libmavsdk.so` and consumers hit a linker error when they try to stream a `Result` (e.g. `std::cout << result;`).\n\nThe equivalent `operator<<` for `MavlinkDirect::Result` in `mavlink_direct.hpp` already uses `MAVSDK_PUBLIC` \u2014 this PR just mirrors that pattern for consistency.\n\nFixes #2880.", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2881/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2881/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4465402664", "html_url": "https://github.com/mavlink/MAVSDK/issues/2880#issuecomment-4465402664", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2880", "id": 4465402664, "node_id": "IC_kwDOBabE0s8AAAABCiijKA", "user": {"login": "evanofficial", "id": 51132505, "node_id": "MDQ6VXNlcjUxMTMyNTA1", "avatar_url": "https://avatars.githubusercontent.com/u/51132505?v=4", "gravatar_id": "", "url": "https://api.github.com/users/evanofficial", "html_url": "https://github.com/evanofficial", "followers_url": "https://api.github.com/users/evanofficial/followers", "following_url": "https://api.github.com/users/evanofficial/following{/other_user}", "gists_url": "https://api.github.com/users/evanofficial/gists{/gist_id}", "starred_url": "https://api.github.com/users/evanofficial/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/evanofficial/subscriptions", "organizations_url": "https://api.github.com/users/evanofficial/orgs", "repos_url": "https://api.github.com/users/evanofficial/repos", "events_url": "https://api.github.com/users/evanofficial/events{/privacy}", "received_events_url": "https://api.github.com/users/evanofficial/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-16T03:29:51Z", "updated_at": "2026-05-16T03:29:51Z", "body": "good catch \u2014 just a missing visibility macro, opened #2881 mirroring how MavlinkDirect declares the same operator", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4465402664/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "evanofficial", "id": 51132505, "node_id": "MDQ6VXNlcjUxMTMyNTA1", "avatar_url": "https://avatars.githubusercontent.com/u/51132505?v=4", "gravatar_id": "", "url": "https://api.github.com/users/evanofficial", "html_url": "https://github.com/evanofficial", "followers_url": "https://api.github.com/users/evanofficial/followers", 