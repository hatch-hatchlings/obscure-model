}...{head}", "merges_url": "https://api.github.com/repos/mavlink/MAVSDK/merges", "archive_url": "https://api.github.com/repos/mavlink/MAVSDK/{archive_format}{/ref}", "downloads_url": "https://api.github.com/repos/mavlink/MAVSDK/downloads", "issues_url": "https://api.github.com/repos/mavlink/MAVSDK/issues{/number}", "pulls_url": "https://api.github.com/repos/mavlink/MAVSDK/pulls{/number}", "milestones_url": "https://api.github.com/repos/mavlink/MAVSDK/milestones{/number}", "notifications_url": "https://api.github.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/2893", "html_url": "https://github.com/mavlink/MAVSDK/pull/2893", "diff_url": "https://github.com/mavlink/MAVSDK/pull/2893.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/2893.patch", "merged_at": "2026-06-08T21:18:45Z"}, "body": "Fixes #2892\n\n## Problem\n\nAn ABBA deadlock exists between `send_capture_status` and `send_tracking_status_with_interval`:\n\n- `send_capture_status` acquires `_mutex`, then calls `queue_message()` which acquires `_mavlink_packet_mutex`\n- `send_tracking_status_with_interval` calls `queue_message()` (acquiring `_mavlink_packet_mutex`), and the callback passed to it acquires `_mutex`\n\nIf both run concurrently, each thread can end up holding one lock and waiting for the other.\n\n## Fix\n\nSnapshot all `_mutex`-protected data into local variables before calling `queue_message()` in both functions. Neither function now holds `_mutex` across the `queue_message()` call, eliminating the lock ordering inversion.", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2893/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2893/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4641369893", "html_url": "https://github.com/mavlink/MAVSDK/issues/2892#issuecomment-4641369893", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2892", "id": 4641369893, "node_id": "IC_kwDOBabE0s8AAAABFKWvJQ", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.git