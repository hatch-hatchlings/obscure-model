VSDK/issues/comments{/number}", "contents_url": "https://api.github.com/repos/mavlink/MAVSDK/contents/{+path}", "compare_url": "https://api.github.com/repos/mavlink/MAVSDK/compare/{base}...{head}", "merges_url": "https://api.github.com/repos/mavlink/MAVSDK/merges", "archive_url": "https://api.github.com/repos/mavlink/MAVSDK/{archive_format}{/ref}", "downloads_url": "https://api.github.com/repos/mavlink/MAVSDK/downloads", "issues_url": "https://api.github.com/repos/mavlink/MAVSDK/issues{/number}", "pulls_url": "https://api.github.com/repos/mavlink/MAVSDK/pulls{/number}", "milestones_url": "https://api.github.com/repos/mavlink/MAVSDK/milestones{/number}", "notifications_url": "https://api.github.com/repos/mavlink/MAVSDK/notifications{?since,all,participating}", "labels_url": "https://api.github.com/repos/mavlink/MAVSDK/labels{/name}", "releases_url": "https://api.github.com/repos/mavlink/MAVSDK/releases{/id}", "deployments_url": "https://api.github.com/repos/mavlink/MAVSDK/deployments", "created_at": "2017-06-19T19:54:57Z", "updated_at": "2026-08-27T23:10:48Z", "pushed_at": "2026-08-26T03:17:02Z", "git_url": "git://github.com/mavlink/MAVSDK.git", "ssh_url": "git@github.com:mavlink/MAVSDK.git", "clone_url": "https://github.com/mavlink/MAVSDK.git", "svn_url": "https://github.com/mavlink/MAVSDK", "homepage": "https://mavsdk.mavlink.io", "size": 54291, "stargazers_count": 928, "watchers_count": 928, "language": "C++", "has_issues": true, "has_projects": false, "has_downloads": false, "has_wiki": false, "has_pages": false, "has_discussions": false, "forks_count": 637, "mirror_url": null, "archived": false, "disabled": false, "open_issues_count": 44, "license": {"key": "bsd-3-clause", "name": "BSD 3-Clause \"New\" or \"Revised\" License", "spdx_id": "BSD-3-Clause", "url": "https://api.github.com/licenses/bsd-3-clause", "node_id": "MDc6TGljZW5zZTU="}, "allow_forking": true, "is_template": false, "web_commit_signoff_required": false, "has_pull_requests": true, "pull_request_creation_policy": "all", "topics": ["ardupilot", "cpp", "cpp17", "mavlink", "px4"], "visibility": "public", "forks": 637, "open_issues": 44, "watchers": 928, "default_branch": "main", "permissions": {"admin": false, "maintain": false, "push": false, "triage": false, "pull": true}}, "pull_request": {"url": "https://api.github.com/repos/mavlink/MAVSDK/pulls/2899", "html_url": "https://github.com/mavlink/MAVSDK/pull/2899", "diff_url": "https://github.com/mavlink/MAVSDK/pull/2899.diff", "patch_url": "https://github.com/mavlink/MAVSDK/pull/2899.patch", "merged_at": "2026-06-12T01:51:59Z"}, "body": "## Description\r\nOn Android, `get_cache_directory()` reads `/proc/self/cmdline` to build the MAVSDK cache path under `/data/data/<package>/mavsdk_cache`.  `/proc/self/cmdline` is NUL-separated.  The current code attempts to strip out the null byte, but does so by de-referencing `line.end()`, which is one byte past the end and undefined. \r\n\r\nThis changes the Android path lookup to read only until the first NUL-delimited entry from `/proc/self/cmdline`, so the cache path is built without the embedded null byte.\r\n\r\n## Testing\r\nTested with `mavsdk_server` on Android and verified camera definitions are cached under `/data/data/<package>/mavsdk_cache/...`, and MAVSDK Camera `getCurrentSettings()` no longer returns `UNAVAILABLE`.\r\n\r\n## Addresses\r\nhttps://github.com/mavlink/MAVSDK/issues/2896", "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2899/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 1, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/2899/timeline", "performed_via_github_app": null, "state_reason": null}}, "event": "cross-referenced"}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/4686276588", "html_url": "https://github.com/mavlink/MAVSDK/issues/2896#issuecomment-4686276588", "issue_url": "https://api.github.com/repos/