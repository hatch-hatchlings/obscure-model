, "node_id": "MDEyOklzc3VlQ29tbWVudDQwOTg4MTc1Nw==", "user": {"login": "lbegani", "id": 18675790, "node_id": "MDQ6VXNlcjE4Njc1Nzkw", "avatar_url": "https://avatars.githubusercontent.com/u/18675790?v=4", "gravatar_id": "", "url": "https://api.github.com/users/lbegani", "html_url": "https://github.com/lbegani", "followers_url": "https://api.github.com/users/lbegani/followers", "following_url": "https://api.github.com/users/lbegani/following{/other_user}", "gists_url": "https://api.github.com/users/lbegani/gists{/gist_id}", "starred_url": "https://api.github.com/users/lbegani/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/lbegani/subscriptions", "organizations_url": "https://api.github.com/users/lbegani/orgs", "repos_url": "https://api.github.com/users/lbegani/repos", "events_url": "https://api.github.com/users/lbegani/events{/privacy}", "received_events_url": "https://api.github.com/users/lbegani/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-02T10:29:44Z", "updated_at": "2018-08-02T10:29:44Z", "body": "@damadamn Depends on the handler (of the mavlink message) where it stores them locally.\r\nIf you are using `camera-manager` , by default the media is stored in `/tmp` directory. The path can be configured in conf file. Hosting the media files in server(http etc) and returning the URL is not yet supported by `camera-manager`", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/409881757/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/409906819", "html_url": "https://github.com/mavlink/MAVSDK/issues/478#issuecomment-409906819", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/478", "id": 409906819, "node_id": "MDEyOklzc3VlQ29tbWVudDQwOTkwNjgxOQ==", "user": {"login": "damadamn", "id": 34715662, "node_id": "MDQ6VXNlcjM0NzE1NjYy", "avatar_url": "https://avatars.githubusercontent.com/u/34715662?v=4", "gravatar_id": "", "url": "https://api.github.com/users/damadamn", "html_url": "https://github.com/damadamn", "followers_url": "https://api.github.com/users/damadamn/followers", "following_url": "https://api.github.com/users/damadamn/following{/other_user}", "gists_url": "https://api.github.com/users/damadamn/gists{/gist_id}", "starred_url": "https://api.github.com/users/damadamn/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/damadamn/subscriptions", "organizations_url": "https://api.github.com/users/damadamn/orgs", "repos_url": "https://api.github.com/users/damadamn/repos", "events_url": "https://api.github.com/users/damadamn/events{/privacy}", "received_events_url": "https://api.github.com/users/damadamn/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-02T12:19:58Z", "updated_at": "2018-08-02T12:47:53Z", "body": "@lbegani I'm using the [Camera class](https://sdk.dronecode.org/v/master/en/api_reference/classdronecore_1_1_camera.html) into a little cpp program, and I run it locally inside the Aero using directly a keyboard/monitor or with SSH connection.\r\nI check inside the `/tmp` folders, just get 1 folder with nothing at end `systemd-private-a28...-systemd-timesyncd.service-.../tmp`.\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/409906819/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/410957452", "html_url": "https://github.com/mavlink/MAVSDK/issues/478#issuecomment-410957452", "issue_url":