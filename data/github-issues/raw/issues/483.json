ssignees": [{"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}], "milestone": null, "comments": 5, "created_at": "2018-08-07T21:13:25Z", "updated_at": "2018-08-17T12:00:42Z", "closed_at": "2018-08-17T12:00:41Z", "assignee": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "Hi,\r\n\r\nI compiled the SDK on Mac OS (Sierra) and did system-wide install. However there is no `sudo ldconfig` (which is used on Linux to update the linker cache) in Mac. **What is the equivalent way to do it in Mac?**\r\n\r\nI also followed the sdk guide (https://sdk.dronecode.org/en/guide/toolchain.html) in order to compile a custom C++ app, and created a custom app and the corresponding CMakeLists.txt.\r\n\r\nHowever, when I run `make`, I get,\r\n```bash\r\n[ 50%] Building CXX object CMakeFiles/formation_gs.dir/formation_gs.cpp.o\r\n/Users/abdkadma/Desktop/src/DroneCode_apps/formation_gs.cpp:15:10: fatal error:\r\n      'dronecode_sdk/action.h' file not found\r\n#include <dronecode_sdk/action.h>\r\n         ^~~~~~~~~~~~~~~~~~~~~~~~\r\n1 error generated.\r\nmake[2]: *** [CMakeFiles/formation_gs.dir/formation_gs.cpp.o] Error 1\r\nmake[1]: *** [CMakeFiles/formation_gs.dir/all] Error 2\r\nmake: *** [all] Error 2\r\n```\r\n\r\nSo, what could be the problem here? Is it because the linker cache is not updated?", "closed_by": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, "comments": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411213902", "html_url": "https://github.com/mavlink/MAVSDK/issues/483#issuecomment-411213902", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483", "id": 411213902, "node_id": "MDEyOklzc3VlQ29tbWVudDQxMTIxMzkwMg==", "user": {"login": "mzahana", "id": 8803307, "node_id": "MDQ6VXNlcjg4MDMzMDc=", "avatar_url": "https://avatars.githubusercontent.com/u/8803307?v=4", "gravatar_id": "", "url": "https://api.github.com/users/mzahana", "html_url": "https://github.com/mzahana", "followers_url": "https://api.github.com/users/mzahana/followers", "following_url": "https://api.github.com/users/mzahana/following{/other_user}", "gists_url": "https://api.github.com/users/mzahana/gists{/gist_id}", "starred_url": "https://api.github.com/users/mzahana/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/mzahana/subscriptions", "organizations_url": "https://api.github.com/users/mzahana/orgs", "repos_url": "https://api.github.com/users/mzahana/repos", "events_url": "https://api.github.com/users/mzahana/events{/privacy}", "received_events_url": "https://api.github.com/users/mzahana/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-07T21:48:57Z", "updated_at": "2018-08-07T21:48:57Z", "body": "Issue is solved by specifying the include and lib system directories in the CMakeLists.txt.\r\n\r\nWould the tutorials need to be updated in order to account for this?\r\n\r\n```bash\r\nif(NOT MSVC)\r\n    add_definitions(\"-std=c++11 -Wall -Wextra -Werror\")\r\n    include_directories(/usr/local/include)\r\n    link_directories(/usr/local/lib)\r\nelse()\r\n    add_definitions(\"-std=c++11 -WX -W2\")\r\n    include_directories(${CMAKE_SOURCE_DIR}/../../install/include)\r\n    link_directories(${CMAKE_SOURCE_DIR}/../../install/lib)\r\nendif()\r\n```", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411213902/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411216830", "html_url": "https://github.com/mavlink/MAVSDK/issues/483#issuecomment-411216830", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483", "id": 411216830, "node_id": "MDEyOklzc3VlQ29tbWVudDQxMTIxNjgzMA==", "user": {"login": "mzahana", "id": 8803307, "node_id": "MDQ6VXNlcjg4MDMzMDc=", "avatar_url": "https://avatars.githubusercontent.com/u/8803307?v=4", "gravatar_id": "", "url": "https://api.github.com/users/mzahana", "html_url": "https://github.com/mzahana", "followers_url": "https://api.github.com/users/mzahana/followers", "following_url": "https://api.github.com/users/mzahana/following{/other_user}", "gists_url": "https://api.github.com/users/mzahana/gists{/gist_id}", "starred_url": "https://api.github.com/users/mzahana/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/mzahana/subscriptions", "organizations_url": "https://api.github.com/users/mzahana/orgs", "repos_url": "https://api.github.com/users/mzahana/repos", "events_url": "https://api.github.com/users/mzahana/events{/privacy}", "received_events_url": "https://api.github.com/users/mzahana/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-07T22:01:00Z", "updated_at": "2018-08-07T22:01:00Z", "body": "Also, I would like to mention that I used the `develop` branch.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411216830/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411227008", "html_url": "https://github.com/mavlink/MAVSDK/issues/483#issuecomment-411227008", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483", "id": 411227008, "node_id": "MDEyOklzc3VlQ29tbWVudDQxMTIyNzAwOA==", "user": {"login": "hamishwillee", "id": 5368500, "node_id": "MDQ6VXNlcjUzNjg1MDA=", "avatar_url": "https://avatars.githubusercontent.com/u/5368500?v=4", "gravatar_id": "", "url": "https://api.github.com/users/hamishwillee", "html_url": "https://github.com/hamishwillee", "followers_url": "https://api.github.com/users/hamishwillee/followers", "following_url": "https://api.github.com/users/hamishwillee/following{/other_user}", "gists_url": "https://api.github.com/users/hamishwillee/gists{/gist_id}", "starred_url": "https://api.github.com/users/hamishwillee/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/hamishwillee/subscriptions", "organizations_url": "https://api.github.com/users/hamishwillee/orgs", "repos_url": "https://api.github.com/users/hamishwillee/repos", "events_url": "https://api.github.com/users/hamishwillee/events{/privacy}", "received_events_url": "https://api.github.com/users/hamishwillee/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-07T22:46:40Z", "updated_at": "2018-08-07T22:46:40Z", "body": "> Also, I would like to mention that I used the develop branch.\r\n\r\nThat is the correct branch to use. Develop is for ongoing development, master is for the last official release.\r\n\r\nRegarding the install directories, did you install dronecode system wide or locally?  If you installed locally, then you do need to tell the system where the includes are: https://sdk.dronecode.org/en/guide/toolchain.html#sdk_local_install\r\nMy understanding is that if you installed system wide you shouldn't have to. \r\n\r\nIF you did and this is needed then yes, we will have to update a bunch of things, including test scripts and docs. ", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/411227008/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/412771601", "html_url": "https://github.com/mavlink/MAVSDK/issues/483#issuecomment-412771601", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483", "id": 412771601, "node_id": "MDEyOklzc3VlQ29tbWVudDQxMjc3MTYwMQ==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-08-14T06:47:08Z", "updated_at": "2018-08-14T08:27:14Z", "body": "> So, what could be the problem here? Is it because the linker cache is not updated?\r\n\r\nIf an include file is not found, the include directories are wrong. This has nothing to do with the linker.\r\n\r\n> However there is no sudo ldconfig (which is used on Linux to update the linker cache) in Mac. What is the equivalent way to do it in Mac?\r\n\r\nhttps://stackoverflow.com/questions/1451047/ldconfig-equivalent-in-mac-os-x\r\n\r\nIt is common practice that in development libraries are installed to `/usr/local/lib` and `/usr/local/include`.\r\n\r\nI tried to address your confusion in https://github.com/dronecore/sdk_docs/pull/136.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/412771601/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/413843372", "html_url": "https://github.com/mavlink/MAVSDK/issues/483#issuecomment-413843372", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/483", "id": 413843372, "node_id": "MDEyOklzc3VlQ29tbWVudDQxMzg0MzM3Mg==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": ""