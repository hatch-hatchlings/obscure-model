T14:24:33Z", "body": "Hehe, see :smile: .\r\n\r\nZoom is something we don't have a mavlink spec for yet, that's indeed something missing.\r\n\r\n> NOTE: Is it possible to control an SBUS gimbal using MAVLink?\r\n\r\nIf the autopilot had a driver implemented for it, yes.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/427038749/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/427049253", "html_url": "https://github.com/mavlink/MAVSDK/issues/570#issuecomment-427049253", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/570", "id": 427049253, "node_id": "MDEyOklzc3VlQ29tbWVudDQyNzA0OTI1Mw==", "user": {"login": "AlexisTM", "id": 6976744, "node_id": "MDQ6VXNlcjY5NzY3NDQ=", "avatar_url": "https://avatars.githubusercontent.com/u/6976744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/AlexisTM", "html_url": "https://github.com/AlexisTM", "followers_url": "https://api.github.com/users/AlexisTM/followers", "following_url": "https://api.github.com/users/AlexisTM/following{/other_user}", "gists_url": "https://api.github.com/users/AlexisTM/gists{/gist_id}", "starred_url": "https://api.github.com/users/AlexisTM/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/AlexisTM/subscriptions", "organizations_url": "https://api.github.com/users/AlexisTM/orgs", "repos_url": "https://api.github.com/users/AlexisTM/repos", "events_url": "https://api.github.com/users/AlexisTM/events{/privacy}", "received_events_url": "https://api.github.com/users/AlexisTM/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2018-10-04T14:52:03Z", "updated_at": "2018-10-04T14:52:03Z", "body": "On top of that, I am using the Offboard mode (PX4 1.8.0+)", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/427049253/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/731125604", "html_url": "https://github.com/mavlink/MAVSDK/issues/570#issuecomment-731125604", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/570", "id": 731125604, "node_id": "MDEyOklzc3VlQ29tbWVudDczMTEyNTYwNA==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2020-11-20T11:53:27Z", "updated_at": "2020-11-20T11:53:27Z", "body": "No one else has asked for roll, so I'm closing this.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/731125604/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1803636340", "html_url": "https://github.com/mavlink/MAVSDK/issues/570#issuecomment-1803636340", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/570", "id": 1803636340, "node_id": "IC_kwDOBabE0s5rgU50", "user": {"login": "Daybreakerflint", "id": 45481353, "node_id": "MDQ6VXNlcjQ1NDgxMzUz", "avatar_url": "https://avatars.githubusercontent.com/u/45481353?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Daybreakerflint", "html_url": "https://github.com/Daybreakerflint", "followers_url": "https://api.github.com/users/Daybreakerflint/followers", "following_url": "https://api.github.com/users/Daybreakerflint/following{/other_user}", "gists_url": "https://api.github.com/users/Daybreakerflint/gists{/gist_id}", "starred_url": "https://api.github.com/users/Daybreakerflint/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Daybreakerflint/subscriptions", "organizations_url": "https://api.github.com/users/Daybreakerflint/orgs", "repos_url": "https://api.github.com/users/Daybreakerflint/repos", "events_url": "https://api.github.com/users/Daybreakerflint/events{/privacy}", "received_events_url": "https://api.github.com/users/Daybreakerflint/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2023-11-09T11:15:12Z", "updated_at": "2023-11-09T12:15:12Z", "body": "**Why would this be needed?**\r\n- Our drone system will be mounted with a dual polarized antenna (Horizontal/Vertical). To test the effects of missaligment to the target, one should be able to set the roll of the antenna.\r\n- In the cases where two axis are switched, as in my case where I am only able to control yaw and roll, it would be nice to have a workaround to set all three angles.\r\n\r\n**Implementation idea**\r\n- Setting the quaterion directly\r\n- A function to set pitch, yaw and roll angle\r\n\r\n**My situation**\r\nI connected my gimbal (Gremsy Pixy U) to my flight controller (Pixhawk 6x) and I want to control exactly where the gimbal is pointing to. In the final version I think ROI will be used but for testing all the functions of the system attached, manual settings will be used.\r\n\r\nI am also facing the problem that my pitch and roll angle are switched. So if I set a pitch angle, the roll is set on the gimbal. I have not yet found where the issue is. \r\n**Edit: The error was in the mounting. I had the system facing the wrong way.** For those who stumble across this. Check on where the gimbal is pointing to.\r\n\r\nCheers.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/1803636340/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}], "timeline": [{"id": 1884310465, "node_id": "MDEyOkxhYmVsZWRFdmVudDE4ODQzMTA0NjU=", "url": "https://api.github.com/repos/mavlink/MAVSDK/issues/events/1884310465", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoe