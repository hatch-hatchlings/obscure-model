anoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/727/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/727/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}, "comments": [{"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/485797758", "html_url": "https://github.com/mavlink/MAVSDK/issues/727#issuecomment-485797758", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/727", "id": 485797758, "node_id": "MDEyOklzc3VlQ29tbWVudDQ4NTc5Nzc1OA==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-04-23T13:15:13Z", "updated_at": "2019-04-23T13:15:13Z", "body": "I can reproduce the problem:\r\n```\r\npython3 takeoff_and_land.py \r\n-- Arming\r\nTraceback (most recent call last):\r\n  File \"takeoff_and_land.py\", line 21, in <module>\r\n    loop.run_until_complete(run())\r\n  File \"/usr/lib64/python3.7/asyncio/base_events.py\", line 584, in run_until_complete\r\n    return future.result()\r\n  File \"takeoff_and_land.py\", line 13, in run\r\n    await drone.action.arm()\r\n  File \"/home/julianoes/.local/lib/python3.7/site-packages/dronecode_sdk/plugins/action.py\", line 167, in arm\r\n    raise ActionError(result, \"arm()\")\r\ndronecode_sdk.plugins.action.ActionError: COMMAND_DENIED_LANDED_STATE_UNKNOWN: 'Command denied, landed state is unknown'; origin: arm(); params: ()\r\n```", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/485797758/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/485799055", "html_url": "https://github.com/mavlink/MAVSDK/issues/727#issuecomment-485799055", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/727", "id": 485799055, "node_id": "MDEyOklzc3VlQ29tbWVudDQ4NTc5OTA1NQ==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-04-23T13:18:50Z", "updated_at": "2019-04-23T13:18:50Z", "body": "`time.sleep(3)` before arming does not seem to help.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/485799055/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/485799763", "html_url": "https://github.com/mavlink/MAVSDK/issues/727#issuecomment-485799763", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/727", "id": 485799763, "node_id": "MDEyOklzc3VlQ29tbWVudDQ4NTc5OTc2Mw==", "user": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_vi