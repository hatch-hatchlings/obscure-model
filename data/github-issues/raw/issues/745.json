s.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-05-13T13:07:47Z", "updated_at": "2019-05-13T13:07:47Z", "body": "> I'd like to add that as a MAVLink SDK it will need MAVLink command passthrough functions to provide complete MAVLink functionality.\r\n\r\nThat's not the intent and not easily possible. The intent is to provide an SDK with certain functionality which uses MAVLink under the hood for the communcation to the drone. However, it does not necessarily expose the MAVLink API. If the raw MAVLink API is required, an implementation of MAVLink in a specific programming language should be used instead.\r\n\r\nFor the C++ library it is possible to export the C API as a passthrough / backdoor. However, if this API would be passed on to the language bindings, either all of the MAVLink messages would need to be added to the protobuf messaging or everything would need to be assembled at runtime which would require the SDK to parse the whole xml MAVLink definitions.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/491814743/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/491831861", "html_url": "https://github.com/mavlink/MAVSDK/issues/745#issuecomment-491831861", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/745", "id": 491831861, "node_id": "MDEyOklzc3VlQ29tbWVudDQ5MTgzMTg2MQ==", "user": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-05-13T13:54:03Z", "updated_at": "2019-05-13T13:56:19Z", "body": "Thanks @laurenwinter for the comment!\r\n\r\nI agree with Julian, though, and I would like to add that IMO, the passthrough is not a very nice way to provide \"complete MAVLink functionality\" (as in: not super elegant, not community-friendly, and soon not faster). Let's compare what it (currently) takes to add a feature to the SDK and what it takes to use the passthrough (again, that's my opinion and maybe I am missing something there):\r\n\r\n### SDK\r\n\r\n1. Define the API as a proto definition\r\n2. Implement the mavlink logic in a C++ plugin\r\n3. Implement the gRPC server boilerplate to bring that to the language bindings (Swift, Python, Java, ...)\r\n4. Auto-generate the language bindings\r\n\r\n### Passthrough\r\n\r\nA. Define the interface for the new features (not necessary, but any readable piece of code would likely do it: that is about putting one feature in one function)\r\nB. Implement the mavlink logic through the passthrough\r\n\r\nNote that:\r\n\r\n* 1 is trivial and corresponds to A.\r\n* 2 corresponds to B.\r\n* 3 is currently \"boilerplate\" to write, but we are working on having that auto-generated (that's one of the top priorities). Once finished, it will be merged with 4.\r\n* 4 comes almost for free (\"just run the auto-generation script\").\r\n\r\nAs a conclusion, I understand that the passthrough may seem faster to implement now (because of 3), but we are putting a lot of effort into removing the costs related to 3.\r\nAlso, what is implemented into the SDK is \"contributed\" to the community in all the supported languages, whereas whatever is written with the passthrough will never come back upstream, and is technically limited to C++. And in that sense, using the passthrough goes \"against\" the community.\r\n\r\nNot sure if that makes sense, but under those conditions, I don't see a use-case that actually wants the mavlink passthrough. What I believe you want is the full auto-generation, and we are working hard on that! :blush:.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/491831861/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "JonasVautherin", "id": 2606672, "node_id": "MDQ6VXNlcjI2MDY2NzI=", "avatar_url": "https://avatars.githubusercontent.com/u/2606672?v=4", "gravatar_id": "", "url": "https://api.github.com/users/JonasVautherin", "html_url": "https://github.com/JonasVautherin", "followers_url": "https://api.github.com/users/JonasVautherin/followers", "following_url": "https://api.github.com/users/JonasVautherin/following{/other_user}", "gists_url": "https://api.github.com/users/JonasVautherin/gists{/gist_id}", "starred_url": "https://api.github.com/users/JonasVautherin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/JonasVautherin/subscriptions", "organizations_url": "https://api.github.com/users/JonasVautherin/orgs", "repos_url": "https://api.github.com/users/JonasVautherin/repos", "events_url": "https://api.github.com/users/JonasVautherin/events{/privacy}", "received_events_url": "https://api.github.com/users/JonasVautherin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}}, {"id": 