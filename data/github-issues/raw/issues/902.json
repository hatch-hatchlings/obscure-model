rough plugin:\r\n\r\n```\r\ncmake -DCMAKE_BUILD_TYPE=Debug -DBUILD_SHARED_LIBS=ON -DENABLE_MAVLINK_PASSTHROUGH -Bbuild/default -H.\r\n```", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/553910215/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/554186204", "html_url": "https://github.com/mavlink/MAVSDK/issues/902#issuecomment-554186204", "issue_url": "https://api.github.com/repos/mavlink/MAVSDK/issues/902", "id": 554186204, "node_id": "MDEyOklzc3VlQ29tbWVudDU1NDE4NjIwNA==", "user": {"login": "felix-west", "id": 57748971, "node_id": "MDQ6VXNlcjU3NzQ4OTcx", "avatar_url": "https://avatars.githubusercontent.com/u/57748971?v=4", "gravatar_id": "", "url": "https://api.github.com/users/felix-west", "html_url": "https://github.com/felix-west", "followers_url": "https://api.github.com/users/felix-west/followers", "following_url": "https://api.github.com/users/felix-west/following{/other_user}", "gists_url": "https://api.github.com/users/felix-west/gists{/gist_id}", "starred_url": "https://api.github.com/users/felix-west/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/felix-west/subscriptions", "organizations_url": "https://api.github.com/users/felix-west/orgs", "repos_url": "https://api.github.com/users/felix-west/repos", "events_url": "https://api.github.com/users/felix-west/events{/privacy}", "received_events_url": "https://api.github.com/users/felix-west/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-11-15T02:47:40Z", "updated_at": "2019-11-15T02:47:40Z", "body": "Thanks for the help. When remaking the build directory like in the installation guide with the command \r\n\" cmake -DCMAKE_BUILD_TYPE=Debug -DBUI