ated_at": "2020-01-17T10:20:59Z", "closed_at": "2020-01-17T10:20:40Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "So currently, with MAVSDK, if the PX4 is either in Position / Altitude / Stabilized / Manual Mode, it will be displayed as Unknown in MAVSDK using Telemetry Flight Mode from API Reference here: https://mavsdk.mavlink.io/develop/en/api_reference/classmavsdk_1_1_telemetry.html#classmavsdk_1_1_telemetry_1aae86fcb399b0368209fcbd35ecdd5fad. it will be very useful for monitoring the state of the drone if it can for example go to Altitude Mode or Position Mode to test if there's either height source sensors or position source sensors. Is there any other way to get the rest of the flight modes mentioned?\r\n", "closed_by": {"login": "julianoes", "id": 1419688, "node_id": "MDQ6VXNlcjE0MTk2ODg=", "avatar_url": "https://avatars.githubusercontent.com/u/1419688?v=4", "gravatar_id": "", "url": "https://api.github.com/users/julianoes", "html_url": "https://github.com/julianoes", "followers_url": "https://api.github.com/users/julianoes/followers", "following_url": "https://api.github.com/users/julianoes/following{/other_user}", "gists_url": "https://api.github.com/users/julianoes/gists{/gist_id}", "starred_url": "https://api.github.com/users/julianoes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/julianoes/subscriptions", "organizations_url": "https://api.github.com/users/julianoes/orgs", "repos_url": "https://api.github.com/users/julianoes/repos", "events_url": "https://api.github.com/users/julianoes/events{/privacy}", "received_events_url": "https://api.github.com/users/julianoes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"