ubscriptions", "organizations_url": "https://api.github.com/users/itrigitech/orgs", "repos_url": "https://api.github.com/users/itrigitech/repos", "events_url": "https://api.github.com/users/itrigitech/events{/privacy}", "received_events_url": "https://api.github.com/users/itrigitech/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2019-12-24T00:01:45Z", "updated_at": "2019-12-24T00:01:45Z", "body": "I'm starting to add the message to the plugin. I'm thinking how to structure the information. The important information in this message is the airspeed for me but the rest of the information we have it already from other messages. I really don't know if there is any difference or not in this information received but i guess not.\r\n\r\nWhat would you do with that? add all the information as it comes ? o just take the information needed? just the airspeed", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/mavlink/MAVSDK/issues/comments/568609818/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null, "event": "commented", "actor": {"login": "itrigitech", "id": 54359274, "node_id": "MDQ6VXNlcjU0MzU5Mjc0", "avatar_url": "https://avatars.githubusercontent.com/u/54359274?v=4", "gravatar_id": "", "url": "https://api.github.com/users/itrigitech", "html_url": "https://github.com/itrigitech", "followers_url": "https://api.github.com/users/itrigitech/followers", "following_url": "https://api.github.com/users/itrigitech/following{/other_user}", "gists_url": "https://api.github.com/users/itrigitech/gists{/gist_id}", "starred_url": "https://api.github.com/users/itrigitech/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/itrigitech/subscriptions", "organizations_url": "https://api.github.com/users/itrigitech/orgs", "repos_url": "https://a